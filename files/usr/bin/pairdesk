                                xalign=0, wrap=True, max_width_chars=60), 1, 0, 1, 1)
            ub = Gtk.Button(label="Undo setup")
            ub.connect("clicked", lambda *_: self.undo_setup())
            g2.attach(ub, 0, 2, 1, 1)
            g2.attach(Gtk.Label(label="Turns USB sharing and network protection off again and removes "
                                      "PairDesk's admin permission. Desktop and folders keep working.",
