# ======================================================================= no-monitor setup
GDM_NOSLEEP = "/etc/dconf/db/gdm.d/90-pairdesk-nosleep"

HEADLESS_STEPS = [
    ("Turn on remote access", "pairdesk access on"),
    ("Keep PairDesk running without anyone signed in", "sudo loginctl enable-linger $USER"),
    ("Install the desktop server (makes its own desktop, no monitor needed)",
     "sudo apt install xrdp xorgxrdp && sudo systemctl enable --now xrdp"),
    ("Turn off automatic sign-in on the screen (it would block xrdp)",
     "sudo sed -i 's/^AutomaticLoginEnable *= *[Tt]rue/AutomaticLoginEnable=false/' /etc/gdm3/custom.conf"),
    ("Don't sleep at the sign-in screen",
     "sudo -u gdm dbus-run-session gsettings set org.gnome.settings-daemon.plugins.power "
     "sleep-inactive-ac-timeout 0"),
    ("Allow PairDesk's port if the firewall (ufw) is on", "sudo ufw allow 4722/tcp"),
    ("Pair: shows the code to type on the other computer", "pairdesk pairing"),
]


def terminal_desktop_server(want):
    """Switch this computer's desktop server from a terminal (e.g. over SSH): 'gnome' (GNOME Remote Login,
    the normal GNOME desktop on Wayland) or 'xrdp'. Asks what it needs; sudo asks for the admin password."""
    import getpass as _gp
    import shutil as _sh
    user = _gp.getuser()
    payload = {"user": user, "password": ""}
    if want == "gnome":
        if not _sh.which("grdctl"):
            raise C.DBError("GNOME Remote Login isn't installed here: sudo apt install gnome-remote-desktop")
        print("GNOME Remote Login shows your normal GNOME desktop, also with no monitor. When you connect, it asks\n"
              "for its own user name and password first, then shows the usual sign-in screen. Choose them now;\n"
              "the computers you connect from keep them in their keyring.")
        u = input("  Remote Login user name [%s]: " % user).strip() or user
        pw = _gp.getpass("  Remote Login password: ")
        if not pw or pw != _gp.getpass("  The same password again: "):
            raise C.DBError("The passwords were empty or didn't match; nothing was changed.")
        payload = {"user": u, "password": pw}
    elif want == "xrdp" and C.gnome_wayland_only():
        print("Note: this GNOME runs only on Wayland, so xrdp can't show it. xrdp needs another desktop (e.g. Xfce)\n"
              "set up for remote sessions in ~/.xsession. GNOME Remote Login is the simple choice here.")
    r = subprocess.run(["sudo", "-p", "  Password for %u (admin): ", C.HELPER, "server-enable", want, user],
                       input=json.dumps(payload), capture_output=True, text=True)
    if r.returncode != 0:
        msg = (r.stderr or r.stdout).strip().splitlines()
        raise C.DBError(msg[-1] if msg else "Switching the desktop server failed.")
    c = C.load_config()
    if c.get("mode") not in ("server", "both"):
        c["mode"] = "both"
        C.save_config(c)
    C.link_start()
    return payload["user"]


def headless_setup(from_client=None):
    """Guided setup of a computer without a monitor (run over SSH: ssh -t user@host pairdesk headless-setup)."""
    import re as _re
    import shutil as _sh
    user = getpass.getuser()

    def ask(q):
        try:
            a = input("  %s [Y/n] " % q).strip().lower()
        except EOFError:
            a = "n"                      # no terminal to answer from: change nothing
        if not sys.stdin.isatty():
            print(a)
        return not a.startswith("n")

    def sudo(cmd):
        print("    $ sudo " + " ".join(cmd))
        return subprocess.run(["sudo", "-p", "    Password for %u (admin): "] + cmd).returncode == 0

    def ok(msg):
        print("  ✔ " + msg)

    print("PairDesk setup for a computer without a monitor (%s, user %s)\n" % (C.hostname(), user))
    print("Each step is checked first; you're asked before anything changes. sudo asks for your password.\n")
    if not can_admin():
        print("! " + "\n  ".join(textwrap.wrap(ADMIN_FIX % user, 76)) + "\n")

    print("1. SSH server program")
    if C.feature_present("accept"):
        ok("installed")
    elif ask("Install openssh-server (PairDesk's link is built on it)?"):
        sudo(["apt-get", "install", "-y", "openssh-server"])

    print("2. Remote access")
    rep = set_mode("both", "none")
    if rep.get("link_error"):
        print("  ✘ " + rep["link_error"])
    else:
        ok("on; PairDesk listens on port %d" % C.link_port())

    print("3. Keep running with nobody signed in")
    lg = subprocess.run(["loginctl", "show-user", user, "-p", "Linger"], capture_output=True, text=True).stdout.strip()
    if lg == "Linger=yes":
        ok("already on")
    elif subprocess.run(["loginctl", "enable-linger"], capture_output=True).returncode == 0:
        ok("turned on")
    elif ask("Turn it on (needs sudo)?"):
        sudo(["loginctl", "enable-linger", user]) and ok("turned on")

    print("4. Desktop server (shows a desktop with no monitor)")
    srv = C.rdp_server()
    use_gnome = _sh.which("grdctl") and (C.gnome_wayland_only() or srv == "gnome")
    if use_gnome and srv == "gnome":
        ok("GNOME Remote Login is on")
    elif use_gnome:
        print("  This GNOME runs on Wayland%s, so GNOME Remote Login is the desktop server to use%s." % (
            " only" if C.gnome_wayland_only() else "", " (xrdp can't show it)" if srv == "xrdp" else ""))
        if ask("Turn on GNOME Remote Login%s?" % (" instead of xrdp" if srv == "xrdp" else "")):
            try:
                terminal_desktop_server("gnome")
                ok("GNOME Remote Login is on")
            except C.DBError as e:
                print("  " + str(e))
    elif C.feature_present("xrdp") and C.port_listening(3389):
        ok("xrdp is installed and running")
    elif ask("Install xrdp and xorgxrdp and start it?"):
        audio = next((p for p in ("pipewire-module-xrdp", "pulseaudio-module-xrdp")
                      if subprocess.run(["apt-cache", "show", p], capture_output=True).returncode == 0), None)
        if sudo(["apt-get", "install", "-y", "xrdp", "xorgxrdp"] + ([audio] if audio else [])):
            if _sh.which("grdctl"):        # free the desktop port from GNOME Remote Login
                sudo(["grdctl", "--system", "rdp", "disable"])
            sudo(["adduser", "xrdp", "ssl-cert"])
            sudo(["systemctl", "enable", "--now", "xrdp"]) and ok("xrdp is running")

    print("5. Automatic sign-in on the screen (would block the remote desktop)")
    conf = next((f for f in ("/etc/gdm3/custom.conf", "/etc/gdm3/daemon.conf", "/etc/gdm/custom.conf")
                 if os.path.exists(f)), None)
    text = open(conf).read() if conf else ""
    if not _re.search(r"^\s*AutomaticLoginEnable\s*=\s*true", text, _re.M | _re.I):
        ok("off")
    elif ask("Turn automatic sign-in off in %s? (takes effect after a restart)" % conf):
        sudo(["sed", "-i", "s/^\\s*AutomaticLoginEnable\\s*=\\s*[Tt]rue/AutomaticLoginEnable=false/", conf]) \
            and ok("off after the next restart")

    print("6. Sleep at the sign-in screen")
    gdm = next((u for u in ("gdm", "Debian-gdm") if subprocess.run(["id", u], capture_output=True).returncode == 0), None)
    if not gdm:
        ok("no GNOME sign-in screen here; nothing to change")
    elif os.path.exists(GDM_NOSLEEP):
        ok("it stays awake")
    elif not _sh.which("dconf"):
        print("  The 'dconf' program is missing, so this can't be changed here. Install it with\n"
              "  sudo apt install dconf-cli  and run this setup again (or rely on Wake-on-LAN).")
    elif ask("Stop the sign-in screen from suspending the computer? (Wake-on-LAN still works if you say no)"):
        # A system setting for the sign-in screen (the documented way); removed when PairDesk is uninstalled.
        import tempfile
        with tempfile.NamedTemporaryFile("w", suffix=".conf", delete=False) as f:
            f.write("# Added by PairDesk: no suspend at the sign-in screen (remote access)\n"
                    "[org/gnome/settings-daemon/plugins/power]\n"
                    "sleep-inactive-ac-timeout=0\nsleep-inactive-ac-type='nothing'\n")
        done = True
        if not any(os.path.exists(x) for x in ("/etc/dconf/profile/gdm", "/usr/share/dconf/profile/gdm")):
            with tempfile.NamedTemporaryFile("w", delete=False) as g:
                g.write("# Added by PairDesk\nuser-db:user\nsystem-db:gdm\n")
            done = sudo(["install", "-D", "-m", "644", g.name, "/etc/dconf/profile/gdm"])
            os.unlink(g.name)
        done = done and sudo(["install", "-D", "-m", "644", f.name, GDM_NOSLEEP]) and sudo(["dconf", "update"])
        os.unlink(f.name)
        if done:
            ok("it stays awake (from the next time the sign-in screen starts)")

    print("7. Firewall")
    st = subprocess.run(["sudo", "-n", "ufw", "status"], capture_output=True, text=True)
    if not _sh.which("ufw"):
        ok("no ufw firewall")
    elif "Status: active" not in st.stdout and st.returncode == 0:
        ok("ufw is off")
    elif ask("Allow PairDesk's port %d in ufw?" % C.link_port()):
        sudo(["ufw", "allow", "%d/tcp" % C.link_port()]) and ok("port %d allowed" % C.link_port())

    addrs = my_addresses()
    print("\nSetup finished. This computer's PairDesk address: " + (" or ".join(addrs) or "(no network address found)"))
    if C.load_config().get("incoming"):
        print("Already paired with: " + ", ".join(sorted(C.load_config()["incoming"])))
    if from_client:
        print("\nBack on %s, press Try again in PairDesk: it will ask this computer for a pairing code." % from_client)
        return
    if ask("Pair the computer you'll connect from now?"):
        print()
        cli(["pairing"])
    else:
        print("\nTo pair later, run here:  pairdesk pairing")


# ======================================================================= self-check
ADMIN_FIX = ("Installing add-ons and setup will fail or ask for the root password. Debian leaves your user out of the sudo group when a root "
             "password was set during installation. Fix: su - -c 'usermod -aG sudo %s', then sign out and in.")


def can_admin():
    """In a group polkit and sudo accept as an administrator (sudo on Debian/Ubuntu, admin on older
    Ubuntu, wheel elsewhere), or root."""
    if os.geteuid() == 0:
        return True
    import grp
    mine = {g.gr_name for g in grp.getgrall() if getpass.getuser() in g.gr_mem}
    try:
        mine.add(grp.getgrgid(os.getgid()).gr_name)
    except KeyError:
        pass
    return bool(mine & {"sudo", "admin", "wheel"})


def doctor(quick=False):
    """Check the current computer. Returns [(level, title, detail)], level is ok / warn / bad / info.
    Nothing is changed; each problem says how to fix it."""
    import shutil as _sh
    out = []

    def add(level, title, detail=""):
        out.append((level, title, detail))
    c = C.load_config()
    user = getpass.getuser()
    on = c.get("mode") in ("server", "both")
    ips = local_ips()
    add("info", "PairDesk %s on %s (user %s)" % (C.VERSION, C.hostname(), user))
    add("ok" if ips else "bad", "Network",
        ", ".join(ips) if ips else "No network address. Check the cable or Wi-Fi.")
    if not can_admin():
        add("warn", "Your user isn't an administrator", ADMIN_FIX % user)

    # ---- connecting to other computers
    if C.feature_present("viewer"):
        add("ok", "Remote desktop viewer", "installed")
    else:
        add("info", "Remote desktop viewer", "Not installed yet. PairDesk offers it the first time you connect.")
    for name, p in sorted(c["peers"].items()):
        if quick:
            break
        port = int(p.get("port", C.LINK_PORT))
        if p.get("needs_pairing") or not p.get("link"):
            add("warn", "%s: pair again" % name, "Press + and request pairing with %s@%s:%d." % (
                p.get("user", user), p.get("host", "?"), port))
        elif C.reachable(p["host"], port, 1.5):
            add("ok", "%s answers" % name, "%s:%d" % (p["host"], port))
        else:
            add("warn", "%s doesn't answer" % name,
                "It may be off or asleep (Connect tries Wake-on-LAN), its remote access may be off, or a firewall "
                "blocks port %d there." % port)

    # ---- being reached
    if not on:
        add("info", "Remote access is off", "Other computers can't connect to this one. Turn it on in "
            "Current computer only if you want to reach this computer from another one.")
    else:
        lp = C.link_port()
        if not C.feature_present("accept"):
            add("bad", "SSH server program missing", "Current computer > Install, or: sudo apt install openssh-server")
        elif C.link_running() or C.port_listening(lp):
            add("ok", "Accepting paired computers", "port %d" % lp)
        else:
            add("bad", "PairDesk's service isn't running", "Turn remote access off and on again; "
                "if it stays off, Help > Open log file shows why.")
        if C.port_listening(3389):
            warn = C.desktop_warning()
            if warn:
                add("warn", "Desktop sharing has a problem", warn)
            else:
                add("ok", "Desktop sharing", "running")
        else:
            add("warn", "Desktop sharing is off", "Folders and USB devices still work. For the desktop: "
                "Current computer > Desktop sharing > Set up…")
        lg = subprocess.run(["loginctl", "show-user", user, "-p", "Linger"], capture_output=True, text=True)
        if lg.returncode == 0 and "Linger=no" in lg.stdout:
            add("warn", "Stops when you sign out", "To accept connections with nobody signed in (no monitor): "
                "sudo loginctl enable-linger " + user)
        if _sh.which("ufw"):
            add("info", "Firewall (ufw)", "If other computers can't reach this one: sudo ufw allow %d/tcp" % lp)
        if c["incoming"]:
            add("ok", "Paired computers that may connect here", ", ".join(sorted(c["incoming"])))
        else:
            add("info", "No computer may connect here yet", "Pair one: on the other computer press + and choose "
                "this computer, or here: Pair a new computer.")
    # ---- USB
    if C.setup_done():
        add("ok", "USB sharing", "ready")
    else:
        add("info", "USB sharing is off (optional)", "Settings > Set up USB sharing, on both computers.")
    return out


def print_doctor():
    marks = {"ok": "✔", "warn": "!", "bad": "✘", "info": "•"}
    res = doctor()
    for level, title, detail in res:
        print(" %s %s" % (marks[level], title))
        if detail:
            for line in textwrap.wrap(detail, 74):
                print("     " + line)
    bad = [r for r in res if r[0] in ("bad", "warn")]
    print("\n%s" % ("Everything looks fine." if not bad else
                     "%d thing%s to look at." % (len(bad), "" if len(bad) == 1 else "s")))
    return 1 if any(r[0] == "bad" for r in res) else 0


# ======================================================================= CLI
def cli_update(a):
    """pairdesk update NAME: update whichever of the two computers has the older PairDesk.
    pairdesk update --install: install the update a paired computer sent here."""
    if a and a[0] == "--install":
        up = C.pending_update()
        if not up:
            print("No update from a paired computer is waiting here.")
            return
        print("Installing PairDesk %s from %s. sudo asks for your password." % (up["version"], up.get("peer")))
        if subprocess.run(["sudo", "apt-get", "install", "-y", up["path"]]).returncode != 0:
            raise C.DBError("installing failed (see above)")
        c = C.load_config()
        c.pop("pending_update", None)
        C.save_config(c)
        os.unlink(up["path"])
        print("PairDesk %s is installed." % up["version"])
        return
    if not a:
        raise IndexError
    s = C.Session(a[0])
    try:
        info = s.open()
        mine, theirs = C.my_version(), info.get("package") or info.get("version")
        way = C.update_direction(mine, theirs)
        if not way:
            print("Both computers have PairDesk %s." % mine)
            return
        if way == "pull":
            if input("%s has PairDesk %s; this computer has %s. Update this computer? [y/N] "
                     % (a[0], theirs, mine)).strip().lower()[:1] != "y":
                return
            print("Copying PairDesk %s from %s ..." % (theirs, a[0]))
            path, ver = s.fetch_package()
            print("Installing it. sudo asks for your password.")
            if subprocess.run(["sudo", "apt-get", "install", "-y", path]).returncode != 0:
                raise C.DBError("installing failed (see above); the package is kept in " + path)
            os.unlink(path)
            print("PairDesk %s is installed." % ver)
            return
        if input("%s has PairDesk %s; this computer has %s. Send this version to %s? [y/N] "
                 % (a[0], theirs, mine, a[0])).strip().lower()[:1] != "y":
            return
        print("Sending PairDesk %s to %s ..." % (mine, a[0]))
        rep = s.push_package(C.package_for_peer())
        if rep.get("state") == "offered":
            print("%s asks on its screen whether to install it; an administrator there confirms." % a[0])
        else:
            print("It's waiting on %s. Install it there (e.g. over SSH) with: pairdesk update --install" % a[0])
    finally:
        s.disconnect()


def term_progress(line):
    """Live progress of admin steps in a terminal: steps, apt's own lines, and waiting for apt's lock."""
    if line.startswith("step:"):
        print("  " + line[5:] + " ...")
    elif line.startswith(("pmstatus:", "dlstatus:")):
        return
    elif "lock" in line.lower() and ("waiting" in line.lower() or "could not get lock" in line.lower()):
        print("  Waiting for another software installation to finish (e.g. automatic updates) ...")
    elif line.strip() and not line.startswith(("Reading", "Building", "(Reading")):
        print("    " + line.strip()[:110])


def cli(argv):
    cmd, a = argv[0], argv[1:]
    C.TERMINAL = sys.stdin.isatty() or os.path.exists("/dev/tty") and bool(os.environ.get("SSH_TTY"))
    if cmd != "link-run":
        if C.migrate_from_deskbridge() and C.load_config().get("mode") in ("server", "both"):
            try:
                C.link_start()
            except C.DBError:
                pass
        old = C.migrate_v2()
        if old:
            print("Note: pair %s again (PairDesk 2.0 uses code pairing)." % ", ".join(old))
    if cmd == "setup":
        print("Setting up USB sharing. sudo asks for your password if needed.")
        st = C.helper_stream("setup", getpass.getuser(), on_line=term_progress)
        C.ensure_key()
        C.share_dir()
        print("Setup done. USB service: %s, SSH: %s" % (
            "running" if st["usbipd_active"] else "NOT running", "running" if st["ssh_active"] else "NOT running"))
        return
    if cmd == "install":
        if not a or a[0] not in C.FEATURES:
            print("Add-ons: " + ", ".join("%s (%s)" % (k, v["title"]) for k, v in C.FEATURES.items()))
            return
        print(C.FEATURES[a[0]]["title"] + ": " + C.feature_text(a[0]).replace("\n\n", "\n"))
        if C.feature_present(a[0]):
            print("Already installed.")
            return
        rep = C.install_feature(a[0], on_line=term_progress)
        print("Installed: " + (", ".join(rep.get("installed", [])) or "nothing new needed"))
        return
    if cmd == "features":
        for k, v in C.FEATURES.items():
            print("%-9s %-40s %s" % (k, v["title"], "installed" if C.feature_present(k) else "not installed"))
        return
    if cmd == "uninstall":
        os.execvp("sudo", ["sudo", "/usr/sbin/pairdesk-uninstall"] + a)
    if cmd == "unsetup":
        rep = C.helper("unsetup", getpass.getuser(), interactive=True)
        C._setup_cache[0] = 0
        print("Setup undone. Desktop and folders keep working; USB sharing is off.")
        if rep.get("kept_for"):
            print("Shared services kept for other users: " + ", ".join(rep["kept_for"]))
        return
    if cmd == "mode":
        backend = a[a.index("--backend") + 1] if "--backend" in a else None
        user = pw = None
        if backend == "gnome":          # asked for explicitly: set up GNOME Remote Login now
            user = input("User name for remote logins [%s]: " % getpass.getuser()).strip() or getpass.getuser()
            pw = getpass.getpass("Password for remote logins: ")
        rep = set_mode(a[0], backend or ("auto" if C.setup_done() else "none"), user, pw,
                       interactive=backend is not None)
        print("Mode: %s%s" % (a[0], (" (desktop server: %s)" % rep["backend"]) if rep.get("backend") else ""))
        if a[0] in ("server", "both"):
            here = C.desktop_server_here()
            if not C.feature_present("accept"):
                print("To accept connections, install the SSH server:  pairdesk install accept")
            if not C.port_listening(3389):
                if here["gnome"]:
                    print("To share the desktop:  pairdesk mode %s --backend gnome   (asks for a remote "
                          "login user name and password)" % a[0])
                else:
                    print("To share the desktop:  pairdesk install xrdp  then  pairdesk mode %s --backend xrdp"
                          % a[0])
        print("Current computer's addresses: " + ", ".join(local_ips()))
        return
    if cmd == "scan":
        print("Looking on your network ...")
        res = C.find_computers()
        for s in res:
            print("  %-22s %s" % (s["name"], s["address"]))
        if not res:
            print("No computer with remote access on was found. Turn it on there (pairdesk access on).")
        else:
            print("Pair with one:  pairdesk pair ADDRESS")
        return
    if cmd == "pair":
        if not a:
            raise C.DBError("Which computer? e.g.  pairdesk pair 192.168.1.20   (pairdesk scan lists them)")
        r = C.resolve_address(a[0])
        if r["state"] == "unknown-host":
            raise C.DBError("No computer called %s was found. Use its IP address." % r["host"])
        if r["state"] not in ("pairdesk", "ssh"):
            raise C.DBError("Nothing answers at %s port %d. On that computer, turn remote access on "
                            "(pairdesk access on) and check its firewall (sudo ufw allow %d/tcp)."
                            % (r["host"], r["port"], r["port"]))
        if not r.get("user"):
            r["user"] = input("Your user name on %s [%s]: " % (r["host"], getpass.getuser())).strip() or getpass.getuser()
        addr = "%s@%s:%d" % (r["user"], r["host"], r["port"])
        if "--ssh" in a:     # sign in over SSH (its password proves it's you): no code to type
            i = a.index("--ssh")
            login = a[i + 1] if len(a) > i + 1 and not a[i + 1].startswith("-") else "%s@%s" % (r["user"], r["host"])
            print("Signing in to %s over SSH to pair (it asks for that computer's password)." % login)
            p = subprocess.run(["ssh", "-o", "ConnectTimeout=10", login, "pairdesk pair-code --plain --turn-on"],
                               stdout=subprocess.PIPE, text=True)
            m = __import__("re").search(r"\b[%s]{4}(?:-[%s]{4}){3}\b" % (C.CODE_ALPHABET, C.CODE_ALPHABET), p.stdout)
            if not m:
                raise C.DBError("Couldn't sign in to %s over SSH (see above)." % login if p.returncode == 255 else
                                "No pairing code came back over SSH (is PairDesk 2.9 installed there?).")
            peer = C.client_pair_code(addr, m.group(0), host_name=r.get("host_name"), log=lambda m: None)
            print("Paired with %s." % peer)
            return
        if len(a) == 1:      # ask the remote computer to show a code, then type it
            name, headless = C.client_request_pairing(addr)
            code = input("Code %s: " % ("from 'pairdesk pairing' on %s" % name if headless else "shown on %s" % name))
        else:
            code = a[1]
        C.client_pair_code(addr, code, host_name=r.get("host_name"))
        return
    if cmd == "access":
        rep = set_mode("both" if a[0] == "on" else "client")
        if a[0] == "on":
            if rep.get("link_error"):
                print("Remote access is on, but the link service isn't running: " + rep["link_error"])
                if not C.feature_present("accept"):
                    print("Install the SSH server program with:  pairdesk install accept")
            else:
                print("Remote access is on. PairDesk listens on port %d." % C.link_port())
                print("Addresses: " + ", ".join(my_addresses()))
        else:
            print("Remote access is off. PairDesk's port is closed.")
        return
    if cmd == "headless-setup":
        headless_setup(a[1] if len(a) > 1 and a[0] == "--from-client" else None)
        return
    if cmd == "pairing":     # for computers without a screen: run over SSH
        import time as _t
        c = C.load_config()
        if c.get("mode") not in ("server", "both"):
            print("Remote access is off. Turn it on with:  pairdesk access on")
            return
        pr = c.get("pairing")
        if not pr or pr["expires"] < _t.time():
            C.start_pairing()
            pr = C.load_config()["pairing"]
            print("No request waiting, so a new pairing code was made.")
        else:
            print("%s asked to pair." % pr.get("requested_by", "A computer") if pr.get("requested_by") else
                  "A pairing code is open.")
        before = dict(C.load_config()["incoming"])
        addrs = my_addresses() or ["ADDRESS"]
        code = C.fmt_code(pr["code"])
        mins = max(1, int(round((pr["expires"] - _t.time()) / 60)))
        print("\n    Code:  %s      (works once, for the next %d minutes)\n" % (code, mins))
        if pr.get("requested_by"):
            print("Next, on %s: type this code in the box PairDesk is showing, and press Pair." % pr["requested_by"])
        else:
            print("Next, on the computer you'll connect from (e.g. your laptop), either:")
            print("  • open PairDesk, press  +  (Add remote computer), choose %s in the list (or type\n"
                  "    its address %s), press Next, then type the code above; or" % (C.hostname(), addrs[0]))
            print("  • run in a terminal:\n      pairdesk pair %s %s" % (addrs[0], code.replace("-", "")))
            if len(addrs) > 1:
                print("  (other addresses of this computer: %s)" % ", ".join(addrs[1:]))
        print("\nWaiting for it here ... (Ctrl+C stops waiting; the code stays valid until it expires)")
        try:
            while True:
                _t.sleep(1)
                c = C.load_config()
                new = [n for n, v in c["incoming"].items() if before.get(n) != v]  # new, or paired again
                if new:
                    who = ", ".join(sorted(new))
                    print("\n✔ Paired with %s.\n" % who)
                    print("Next, on %s: choose this computer (%s) in PairDesk and press Connect." % (who, C.hostname()))
                    st = {}
                    try:
                        st = json.load(open("/etc/pairdesk/system.json"))
                    except (OSError, ValueError):
                        pass
                    if st.get("backend") == "gnome":
                        print("The desktop login asks for the user name and password set in GNOME Remote Login.")
                    else:
                        print("The desktop login asks for this computer's normal user name and password (%s)."
                              % getpass.getuser())
                    if C.signed_in_locally(getpass.getuser()):
                        print("You're also signed in on this computer's own screen; PairDesk will offer to\n"
                              "sign that session out when you connect.")
                    return
                p = c.get("pairing")
                if not p or p["expires"] < _t.time():
                    print("The code expired or was used up. Run 'pairdesk pairing' again for a new one.")
                    return
        except KeyboardInterrupt:
            print()
        return
    if cmd == "link-refresh":    # run by the package after an upgrade, for each user
        C.link_refresh()
        return
    if cmd == "migrate":       # run by the package for each user (the work happens above)
        return
    if cmd == "desktop":
        want = a[0] if a else ""
        if want not in ("gnome", "xrdp"):
            raise C.DBError("Which desktop server? pairdesk desktop gnome   (or: pairdesk desktop xrdp)")
        u = terminal_desktop_server(want)
        print("Desktop server: %s." % ("GNOME Remote Login" if want == "gnome" else "xrdp"))
        if want == "gnome":
            print("When you connect, type the Remote Login name (%s) and password, then sign in as usual.\n"
                  "Don't stay signed in on this computer's own screen: Remote Login can't open the same user twice." % u)
        return
    if cmd in ("doctor", "check"):
        sys.exit(print_doctor())
    if cmd == "pair-code":
        if "--turn-on" in a and C.load_config().get("mode") not in ("server", "both"):
            set_mode("both", "auto" if C.setup_done() else "none")
        code = C.start_pairing()
        if "--plain" in a:      # for "Pair over SSH" on the other computer
            print(code)
            return
        print("On the other computer run:  pairdesk pair ADDRESS %s" % code)
        print("ADDRESS is one of: " + ", ".join(my_addresses()))
        print("The code works once, for 10 minutes.")
        return
    if cmd == "port":
        p = int(a[0])
        if not 1024 <= p <= 65535 or p in (3389, 3240) or 47300 <= p < 47700:
            raise C.DBError("choose a port between 1024 and 65535 not used by PairDesk itself")
        c = C.load_config()
        c["link_port"] = p
        C.save_config(c)
        if c.get("mode") in ("server", "both"):
            C.link_start()
        print("PairDesk uses port %d. Computers paired before need to pair again." % p)
        return
    if cmd == "link-run":
        sys.exit(C.link_run())
    if cmd == "list":
        c = C.load_config()
        print("Current computer: %s  (mode: %s)" % (C.hostname(), c["mode"]))
        for n, p in c["peers"].items():
            print("  -> %-20s %s@%s  send:%s take:%s" % (n, p["user"], p["host"], p["usb_send"], p["usb_take"]))
        for n, p in c["incoming"].items():
            print("  <- %-20s may connect to current computer (slot %d)" % (n, p["slot"]))
        return
    if cmd == "usb":
        for d in C.list_local_usb():
            print("%-8s %-24s %-18s %s%s" % (d["busid"], d["key"], d["kind"], d["name"],
                                             "  [shared]" if d["exported"] else ""))
        return
    if cmd in ("send", "take"):
        c = C.load_config()
        p = c["peers"][a[0]]
        lst = p["usb_send" if cmd == "send" else "usb_take"]
        if a[1] == "off":
            lst.clear()
        elif a[1] not in lst:
            lst.append(a[1])
        C.save_config(c)
        return
    if cmd in ("forget", "unpair"):
        done, note = C.unpair(a[0], both=True, log=print)
        if note:
            print(note)
        return
    if cmd == "update":
        cli_update(a)
        return
    if cmd == "connect":
        s = C.Session(a[0])
        opts = dict(s.p.get("opts", C.DEFAULT_OPTS))
        if "--no-desktop" in a:
            opts["desktop"] = False
        for opt, feat in (("desktop", "viewer"), ("open_theirs", "folders"), ("share_mine", "accept")):
            if opts.get(opt) and not C.feature_present(feat):
                opts[opt] = False
                print("Skipping %s: %s is not installed. Add it with: pairdesk install %s"
                      % (opt.replace("_", " "), C.FEATURES[feat]["title"], feat))
        pw = getpass.getpass("Desktop password for %s on %s: " % (s.p["rdp_user"], a[0])) \
            if opts["desktop"] else None
        done = threading.Event()
        s.on_conflict = lambda name: input("Someone is signed in on %s's screen. Sign that session out after a "
                                           "30-second notice there? [y/N] " % name).strip().lower().startswith("y")
        try:
            s.connect(opts, pw, on_desktop_exit=lambda rc, err: done.set())
            print("Connected. Press Ctrl+C to disconnect.")
            signal.signal(signal.SIGTERM, lambda *_: done.set())
            while not done.wait(1):
                if s.state == "closed":
                    break
        except KeyboardInterrupt:
            pass
        finally:
            s.disconnect()
        return
    print(__doc__)


class X11:
    """The few X11 calls the desktop window needs: size the embedded viewer to the window, and hand it the
    keyboard. Errors (a window that just went away) are ignored instead of ending the app."""
    _lib = _dpy = _handler = None

    @classmethod
    def _init(cls):
        if cls._lib is None:
            import ctypes
            import ctypes.util
            lib = ctypes.cdll.LoadLibrary(ctypes.util.find_library("X11") or "libX11.so.6")
            lib.XOpenDisplay.restype = ctypes.c_void_p
            lib.XOpenDisplay.argtypes = [ctypes.c_char_p]
            lib.XQueryTree.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.POINTER(ctypes.c_ulong),
                                       ctypes.POINTER(ctypes.c_ulong),
                                       ctypes.POINTER(ctypes.POINTER(ctypes.c_ulong)), ctypes.POINTER(ctypes.c_uint)]
            lib.XResizeWindow.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_uint, ctypes.c_uint]
            lib.XSetInputFocus.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int, ctypes.c_ulong]
            lib.XFlush.argtypes = [ctypes.c_void_p]
            lib.XSync.argtypes = [ctypes.c_void_p, ctypes.c_int]
            lib.XFree.argtypes = [ctypes.c_void_p]
            handler_t = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_void_p, ctypes.c_void_p)
            cls._handler = handler_t(lambda d, e: 0)
            lib.XSetErrorHandler(cls._handler)
            cls._lib, cls._dpy = lib, lib.XOpenDisplay(None)
            cls._ct = ctypes
        return cls._lib, cls._dpy

    @classmethod
    def children(cls, win):
        X, dpy = cls._init()
        ct = cls._ct
        root, par, kids, n = ct.c_ulong(), ct.c_ulong(), ct.POINTER(ct.c_ulong)(), ct.c_uint()
        if not dpy or not X.XQueryTree(dpy, win, ct.byref(root), ct.byref(par), ct.byref(kids), ct.byref(n)):
            return []
        out = [kids[i] for i in range(n.value)]
        if kids:
            X.XFree(kids)
        return out

    @classmethod
    def fit(cls, win, w, h):
        X, dpy = cls._init()
        for c in cls.children(win):
            X.XResizeWindow(dpy, c, max(w, 200), max(h, 150))
        X.XFlush(dpy)

    @classmethod
    def focus(cls, win):
        X, dpy = cls._init()
        kids = cls.children(win)
        if kids:
            X.XSetInputFocus(dpy, kids[0], 2, 0)      # RevertToParent, CurrentTime
            X.XSync(dpy, 0)
        return bool(kids)


# ======================================================================= GUI
def gui(auto_connect=None):
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, GLib, Pango, Gdk, Gio

    ACCENTS = {"azure": "#0a6cc4", "blue": "#3584e4", "teal": "#2190a4", "green": "#26a269", "purple": "#9141ac",
               "orange": "#e66100", "red": "#c01c28"}
    CSS = """
    .pd-bar { background-color: #1d232b; color: #e9edf2; padding: 2px 4px; }
    .pd-bar button { color: #e9edf2; min-height: 26px; min-width: 30px; padding: 2px 6px; }
    .pd-bar button:hover { background-color: alpha(#ffffff, 0.12); }
    .pd-bar button.pd-danger:hover { background-color: #c01c28; }
    .pd-pop .pd-bar { border-radius: 0 0 10px 10px; padding: 4px 8px; }
    .pd-desk { background-color: #000000; }
    .db-card { background-color: @theme_base_color; border: 1px solid alpha(@borders, 0.55);
               border-radius: 12px; padding: 10px 14px 12px 14px; }
    .db-card-title { font-weight: bold; font-size: 1.05em; }
    .db-well { border: 1px solid alpha(@borders, 0.55); border-radius: 8px; }
    .db-well list, .db-well list row { background-color: transparent; }
    .db-well list row:hover { background-color: alpha(@theme_fg_color, 0.05); }
    .db-bar { border-top: 1px solid alpha(@borders, 0.55); padding: 8px 12px; }
    .db-muted { opacity: 0.72; }
    list.db-plain, list.db-plain row { background-color: transparent; }
    list.db-plain row:not(:last-child) { border-bottom: 1px solid alpha(@borders, 0.4); }
    .db-pill { border-radius: 999px; padding: 2px 12px; font-size: 0.92em; }
    entry.db-code { font-family: monospace; font-size: 1.25em; }
    button.db-link { color: ACCENT; padding-left: 0; padding-right: 0; }
    button.db-link:hover { background-image: none; background-color: transparent; text-decoration-line: underline; }
    .db-well list row:selected, list.db-plain row:selected { background-color: alpha(ACCENT, 0.18); color: @theme_fg_color; }
    .db-well list row:selected label, list.db-plain row:selected label { color: @theme_fg_color; }
    .db-ok { color: #26a269; } .db-warn { color: #c88800; } .db-bad { color: #c01c28; } .db-info { color: alpha(currentColor, 0.6); }
    button.db-choice { border-radius: 12px; padding: 4px; }
    button.db-choice:hover { border-color: ACCENT; background-image: image(alpha(ACCENT, 0.08)); }
    .db-pill-on { background-image: none; background-color: alpha(#26a269, 0.16); color: #26a269; }
    .db-pill-off { background-image: none; background-color: alpha(@theme_fg_color, 0.07); }
    button { border-radius: 8px; }
    .linked > button, .linked > radiobutton { border-radius: 0; }
    .linked > button:first-child, .linked > radiobutton:first-child { border-radius: 8px 0 0 8px; }
    .linked > button:last-child, .linked > radiobutton:last-child { border-radius: 0 8px 8px 0; }
    button.suggested-action { background-image: none; background-color: ACCENT; color: #ffffff;
                              border-color: shade(ACCENT, 0.85); text-shadow: none; box-shadow: none; }
    button.suggested-action:hover { background-color: shade(ACCENT, 1.1); }
    button.suggested-action:disabled { background-color: alpha(ACCENT, 0.45); color: alpha(#ffffff, 0.75); }
    switch:checked { background-image: none; background-color: ACCENT; border-color: shade(ACCENT, 0.85); }
    check:checked, radio:checked { background-image: image(ACCENT); border-color: shade(ACCENT, 0.85);
                                   color: #ffffff; }
    stackswitcher button:checked, .linked > button:checked, .linked > radiobutton:checked {
        background-image: image(alpha(ACCENT, 0.20)); border-color: alpha(ACCENT, 0.65); }
    """
    css_provider = Gtk.CssProvider()
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css_provider,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def system_prefers_dark():
        src = Gio.SettingsSchemaSource.get_default()
        if src and src.lookup("org.gnome.desktop.interface", True):
            gs = Gio.Settings.new("org.gnome.desktop.interface")
            if "color-scheme" in gs.list_keys() and gs.get_string("color-scheme") == "prefer-dark":
                return True
            return "dark" in (gs.get_string("gtk-theme") or "").lower()
        return False

    ORIG_THEME = Gtk.Settings.get_default().get_property("gtk-theme-name") or "Adwaita"

    def theme_dir(name):
        for base in (os.path.expanduser("~/.themes"), os.path.expanduser("~/.local/share/themes"),
                     "/usr/share/themes"):
            d = os.path.join(base, name, "gtk-3.0")
            if os.path.isdir(d):
                return d
        return None

    # KnowReva graphite & azure: neutrals for light and dark (the accent comes from ACCENTS)
    BRAND = {False: {"BG": "#f4f5f7", "SHEET": "#ffffff", "INK": "#1d232b", "MUTED": "#5d6673", "LINE": "#d9dde3",
                     "HOVER": "#eef1f5"},
             True: {"BG": "#111418", "SHEET": "#181c22", "INK": "#e6e9ee", "MUTED": "#9aa3b0", "LINE": "#2a3038",
                    "HOVER": "#20252d"}}
    BRAND_CSS = """
    window.background, dialog.background, .background { background-color: BG; color: INK; }
    headerbar { background-image: none; background-color: SHEET; border-bottom: 1px solid LINE; box-shadow: none; }
    headerbar .title { color: INK; font-weight: 600; } headerbar .subtitle { color: MUTED; }
    .db-card { background-color: SHEET; border-color: LINE; }
    .db-well, .db-bar { border-color: LINE; }
    .db-muted { opacity: 1; color: MUTED; }
    list, list row, .db-card list { background-color: SHEET; }
    textview, textview text { background-color: SHEET; color: INK; }
    stackswitcher button { background-image: none; background-color: SHEET; border-color: LINE; box-shadow: none; }
    stackswitcher button:hover { background-color: HOVER; }
    stackswitcher button:checked { background-image: none; background-color: alpha(ACCENT, 0.14); color: INK;
                                   border-color: alpha(ACCENT, 0.55); }
    button:not(.suggested-action):not(.destructive-action):not(.titlebutton):not(.db-link):not(.flat) {
        background-image: none; background-color: SHEET; border-color: LINE; box-shadow: none; text-shadow: none; }
    button:not(.suggested-action):not(.destructive-action):not(.titlebutton):not(.db-link):not(.flat):hover {
        background-color: HOVER; }
    entry, combobox button.combo, spinbutton { border-color: LINE; }
    """

    def apply_theme(cfg):
        """Light/dark that works with any theme: use the theme's dark variant, its "-dark"
        twin, or fall back to GTK's built-in Adwaita (which always has both)."""
        theme = cfg.get("theme", "system")
        dark = system_prefers_dark() if theme == "system" else theme == "dark"
        st = Gtk.Settings.get_default()
        base = ORIG_THEME[:-5] if ORIG_THEME.lower().endswith("-dark") else ORIG_THEME
        if theme == "system":
            name = ORIG_THEME if theme_dir(ORIG_THEME) or ORIG_THEME == "Adwaita" else "Adwaita"
        elif dark:
            if theme_dir(base + "-dark"):
                name = base + "-dark"
            elif base == "Adwaita" or (theme_dir(base) and os.path.exists(os.path.join(theme_dir(base), "gtk-dark.css"))):
                name = base
            else:
                name = "Adwaita"
        else:
            name = base if (theme_dir(base) or base == "Adwaita") else "Adwaita"
        if st.get_property("gtk-theme-name") != name:
            st.set_property("gtk-theme-name", name)
        st.set_property("gtk-application-prefer-dark-theme", dark)
        css = CSS
        if cfg.get("style", "brand") == "brand":
            css += BRAND_CSS
            for k, v in BRAND[bool(dark)].items():
                css = css.replace(k, v)
        css_provider.load_from_data(css.replace("ACCENT", ACCENTS.get(cfg.get("accent", "azure"),
                                                                     ACCENTS["azure"])).encode())

    KR = {"Secret": None, "SCHEMA": None}

    def load_keyring():
        if KR["Secret"] is None:
            try:
                gi.require_version("Secret", "1")
                from gi.repository import Secret as S
                KR["Secret"] = S
                KR["SCHEMA"] = S.Schema.new("org.pairdesk.rdp", S.SchemaFlags.NONE,
                                            {"peer": S.SchemaAttributeType.STRING})
            except (ValueError, ImportError):
                pass
        return KR["Secret"]
    load_keyring()

    def bg(fn, done=None, err=None):
        def run():
            try:
                r = fn()
                if done:
                    GLib.idle_add(done, r)
            except Exception as e:  # noqa: BLE001 - show every failure to the user
                GLib.idle_add(err or app.error, str(e))
        threading.Thread(target=run, daemon=True).start()

    def copy(text, button=None):
        """Put text on the clipboard; the button says "Copied" for a moment so it's clear it worked."""
        Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(text, -1)
        if button is not None:
            old = button.get_label()
            button.set_label("Copied ✔")
            GLib.timeout_add(1500, lambda: (button.set_label(old), False)[1])

    def pri(d, resp, danger=False, default=None):
        """Mark a dialog's main button (blue) or risky button (red), and what Enter does: the main action,
        or the safe choice when the main action is risky."""
        b = d.get_widget_for_response(resp)
        if b is not None:
            b.get_style_context().add_class("destructive-action" if danger else "suggested-action")
        d.set_default_response(resp if default is None else default)

    STATUS_RE = __import__("re").compile(r"^(pmstatus|dlstatus):(.+?):([0-9.]+):(.*)$")

    class Progress(Gtk.Dialog):
        """What is happening, a progress bar (from apt's own progress reports), live details."""

        def __init__(self, parent, title, intro):
            super().__init__(title=title, transient_for=parent, modal=True)
            self.set_default_size(540, -1)
            self.set_deletable(False)
            box = self.get_content_area()
            box.set_spacing(10)
            for m in ("set_margin_start", "set_margin_end", "set_margin_top", "set_margin_bottom"):
                getattr(box, m)(16)
            self.head = Gtk.Label(xalign=0, wrap=True)
            self.head.set_markup("<b>%s</b>" % GLib.markup_escape_text(title))
            box.add(self.head)
            self.sub = Gtk.Label(label=intro, xalign=0, wrap=True, max_width_chars=60)
            self.sub.get_style_context().add_class("db-muted")
            box.add(self.sub)
            self.bar = Gtk.ProgressBar(show_text=False)
            box.add(self.bar)
            self.exp = Gtk.Expander(label="Details")
            self.buf = Gtk.TextBuffer()
            self.tv = Gtk.TextView(buffer=self.buf, editable=False, monospace=True, wrap_mode=Gtk.WrapMode.CHAR)
            sw = Gtk.ScrolledWindow(min_content_height=170)
            sw.add(self.tv)
            self.exp.add(sw)
            box.add(self.exp)
            self.btn = self.add_button("Please wait…", 0)
            self.btn.set_sensitive(False)
            self.connect("response", lambda d, r: d.destroy() if self.btn.get_sensitive() else None)
            self.pulsing = True
            GLib.timeout_add(120, self._pulse)
            self.show_all()

        def _pulse(self):
            if self.pulsing:
                self.bar.pulse()
            return self.pulsing

        def line(self, text):
            GLib.idle_add(self._line, text)

        def _line(self, text):
            m = STATUS_RE.match(text)
            if m:
                kind, pct, desc = m.group(1), float(m.group(3)), m.group(4)
                frac = (pct * 0.35 if kind == "dlstatus" else 35 + pct * 0.65) / 100.0
                if self.pulsing:
                    self.pulsing = False
                    self.bar.set_show_text(True)
                self.bar.set_fraction(max(self.bar.get_fraction(), min(frac, 1.0)))
                self.bar.set_text("%d %%" % int(frac * 100))
                self.sub.set_text(desc)
                return False
            if text.startswith("step:"):
                self.sub.set_text(text[5:] + "…")
                return False
            if text[:3] in ("1. ", "2. ", "3. ", "4. "):      # uninstaller steps
                self.sub.set_text(text[3:])
            self.buf.insert(self.buf.get_end_iter(), text + "\n")
            self.tv.scroll_to_iter(self.buf.get_end_iter(), 0, False, 0, 0)
            return False

        def finish(self, ok, msg):
            self.pulsing = False
            if ok:
                self.bar.set_fraction(1.0)
                self.bar.set_show_text(True)
                self.bar.set_text("Done")
            self.head.set_markup("<b>%s</b>" % ("✔ Done" if ok else "✘ Didn't finish"))
            self.sub.set_text(msg)
            if not ok:
                self.exp.set_expanded(True)
            self.btn.set_label("Close")
            self.btn.set_sensitive(True)
            self.set_deletable(True)

    class DesktopWindow(Gtk.Window):
        """The remote desktop inside PairDesk's own window, with a toolbar for everything during a session:
        full screen, minimize, USB devices, camera, folders, the PairDesk window and Disconnect. In full screen
        the toolbar drops down when the pointer touches the top edge."""

        def __init__(self, app, s):
            super().__init__(title="%s - PairDesk" % s.name)
            self.app, self.s = app, s
            self.xid = None
            self.set_icon_name("pairdesk")
            mon = self.get_display().get_primary_monitor() or self.get_display().get_monitor(0)
            g = mon.get_geometry()
            self.set_default_size(int(g.width * 0.8), int(g.height * 0.8))
            self.maximize()      # about the size the session starts at: little to fit afterwards
            self.is_full = False
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            self.bar = self.make_bar(False)
            box.pack_start(self.bar, False, False, 0)
            self.area = Gtk.DrawingArea(can_focus=True)
            self.area.get_style_context().add_class("pd-desk")
            self.area.connect("size-allocate", self.on_size)
            box.pack_start(self.area, True, True, 0)
            self.add(box)
            self.pop = Gtk.Window(type=Gtk.WindowType.POPUP)
            self.pop.get_style_context().add_class("pd-pop")
            self.pop.add(self.make_bar(True))
            self.pop_menu_open = False
            self.connect("delete-event", self.on_close)
            self.connect("focus-in-event", lambda *_: GLib.timeout_add(80, self.give_focus) and False)
            self.connect("window-state-event", self.on_state)
            self.show_all()
            self.area.get_window().ensure_native()
            self.xid = self.area.get_window().get_xid()
            self._hide_at = 0
            GLib.timeout_add(150, self.watch_pointer)

        # -- the viewer inside
        def target(self):
            """The session starts at the full size of the screen and is made smaller to fit the window: some
            desktop servers (xrdp) end the session when it's made larger than it started."""
            g = self.monitor()
            GLib.timeout_add(400, self.fit_when_ready)
            return self.xid, g.width, g.height

        def monitor(self):
            disp = self.get_display()
            m = disp.get_monitor_at_window(self.get_window()) if self.get_window() else disp.get_primary_monitor()
            return (m or disp.get_monitor(0)).get_geometry()

        def fit_when_ready(self):
            if not self.xid or not self.get_realized():
                return False
            if X11.children(self.xid):
                # the viewer's window appears before the sign-in has finished; changing the size during
                # that makes some servers (xrdp) drop the session, so wait a moment
                self._seen = getattr(self, "_seen", 0) + 1
                if self._seen < 25:          # ~10 s: a new xrdp session can take that long to sign in
                    return True
                self.ready = True
                a = self.area.get_allocation()
                X11.fit(self.xid, a.width, a.height)
                self.give_focus()
                return False
            self._fit_tries = getattr(self, "_fit_tries", 0) + 1
            return self._fit_tries < 120

        def on_size(self, _w, r):
            if self.xid and getattr(self, "ready", False):
                X11.fit(self.xid, r.width, r.height)

        def give_focus(self):
            if self.xid and self.get_property("is-active"):
                X11.focus(self.xid)
            return False

        # -- full screen and the drop-down toolbar
        def toggle_full(self, *_):
            if self.is_full:
                self.unfullscreen()
            else:
                self.fullscreen()

        def on_state(self, _w, ev):
            self.is_full = bool(ev.new_window_state & Gdk.WindowState.FULLSCREEN)
            self.bar.set_visible(not self.is_full)
            for b in self.full_buttons:
                b.get_child().set_from_icon_name("view-restore-symbolic" if self.is_full else
                                                 "view-fullscreen-symbolic", Gtk.IconSize.BUTTON)
                b.set_tooltip_text("Leave full screen" if self.is_full else "Full screen")
            if not self.is_full:
                self.pop.hide()

        def watch_pointer(self):
            if not self.get_realized():
                return False
            if not self.is_full or not self.get_property("is-active") and not self.pop.get_visible():
                return True
            seat = self.get_display().get_default_seat()
            _scr, x, y = seat.get_pointer().get_position()
            mon = self.monitor()
            now = time.time()
            if mon.x <= x < mon.x + mon.width and y <= mon.y + 1:
                if not self.pop.get_visible():
                    self.pop.show_all()
                    w = self.pop.get_preferred_width()[1]
                    self.pop.move(mon.x + (mon.width - w) // 2, mon.y)
                self._hide_at = 0
            elif self.pop.get_visible() and not self.pop_menu_open:
                ph = self.pop.get_allocated_height()
                if y > mon.y + ph + 30:
                    if not self._hide_at:
                        self._hide_at = now + 1.2
                    elif now >= self._hide_at:
                        self.pop.hide()
                        self._hide_at = 0
                        self.give_focus()
                else:
                    self._hide_at = 0
            return True

        # -- toolbar
        def make_bar(self, popup):
            bar = Gtk.Box(spacing=2)
            bar.get_style_context().add_class("pd-bar")
            name = Gtk.Label(xalign=0)
            name.set_markup("<b>%s</b>" % GLib.markup_escape_text(self.s.name))
            name.set_margin_start(8)
            name.set_margin_end(10)
            bar.pack_start(name, False, False, 0)

            def btn(icon, tip, cb, cls=None):
                b = Gtk.Button(focus_on_click=False, relief=Gtk.ReliefStyle.NONE, tooltip_text=tip)
                b.add(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.BUTTON))
                if cls:
                    b.get_style_context().add_class(cls)
                b.connect("clicked", cb)
                return b
            bar.pack_start(btn("drive-removable-media-symbolic", "USB devices", self.usb_menu), False, False, 0)
            bar.pack_start(btn("camera-web-symbolic", "Camera", self.camera_menu), False, False, 0)
            bar.pack_start(btn("folder-remote-symbolic", "Folders", self.folder_menu), False, False, 0)
            bar.pack_start(btn("audio-volume-high-symbolic", "Sound and microphone", self.sound_menu), False, False, 0)
            bar.pack_start(btn("pairdesk", "Show the PairDesk window", lambda *_: self.app.present()),
                           False, False, 0)
            bar.pack_end(btn("system-shutdown-symbolic", "Disconnect", self.on_disconnect, "pd-danger"),
                         False, False, 0)
            full = btn("view-fullscreen-symbolic", "Full screen", self.toggle_full)
            if not hasattr(self, "full_buttons"):
                self.full_buttons = []
            self.full_buttons.append(full)
            bar.pack_end(full, False, False, 0)
            bar.pack_end(btn("window-minimize-symbolic", "Minimize", lambda *_: self.iconify()), False, False, 0)
            return bar

        def popup(self, menu, widget):
            menu.show_all()
            self.pop_menu_open = True

            def done(*_):
                self.pop_menu_open = False
                GLib.timeout_add(100, self.give_focus)
            menu.connect("deactivate", done)
            menu.popup_at_widget(widget, Gdk.Gravity.SOUTH_WEST, Gdk.Gravity.NORTH_WEST, None)

        @staticmethod
        def head(menu, text):
            it = Gtk.MenuItem(label=text, sensitive=False)
            menu.append(it)

        def usb_menu(self, widget):
            s, app, n = self.s, self.app, self.s.name
            m = Gtk.Menu()
            ok_here = getattr(app, "usb_ok", True)
            ok_there = s.info.get("usb_ready", True)
            self.head(m, "Send to %s" % n)
            devs = C.list_local_usb()
            for d in devs:
                it = Gtk.CheckMenuItem(label="%s (%s)" % (d["name"], d["kind"]))
                it.set_active(d["busid"] in s.sent)
                it.set_sensitive(ok_here and ok_there)
                it.connect("toggled", lambda i, d=d: app.set_local_usb(d, i.get_active()))
                m.append(it)
            if not devs:
                self.head(m, "   No USB devices here")
            m.append(Gtk.SeparatorMenuItem())
            self.head(m, "Use here, from %s" % n)
            for d in app.remote_devs:
                it = Gtk.CheckMenuItem(label="%s (%s)" % (d["name"], d["kind"]))
                it.set_active(d["busid"] in s.taken)
                it.set_sensitive(ok_here and ok_there)
                it.connect("toggled", lambda i, d=d: app.set_remote_usb(d, i.get_active()))
                m.append(it)
            if not app.remote_devs:
                self.head(m, "   None found")
            app.refresh_remote()
            if not ok_here or not ok_there:
                m.append(Gtk.SeparatorMenuItem())
            if not ok_here:
                it = Gtk.MenuItem(label="Set up USB sharing on this computer…")
                it.connect("activate", lambda *_: app.do_setup())
                m.append(it)
            if not ok_there:
                it = Gtk.MenuItem(label="Set up USB sharing on %s over SSH…" % n)
                it.connect("activate", lambda *_: app.remote_install(s, ["usb"], lambda: None))
                m.append(it)
            self.popup(m, widget)

        def camera_menu(self, widget):
            s, app = self.s, self.app
            m = Gtk.Menu()
            cams = C.list_cameras()
            self.head(m, "Send as video to %s" % s.name)
            for cam in cams:
                it = Gtk.CheckMenuItem(label=cam["name"])
                it.set_active(bool(s.camera) and s.camera["dev"] == cam["dev"])
                it.connect("toggled", lambda i, cam=cam: app.set_camera(cam, i.get_active()))
                m.append(it)
            lent = [d for d in C.list_local_usb() if d["kind"] == "camera" and (d["busid"] in s.sent or d["exported"])]
            for d in lent:
                it = Gtk.MenuItem(label="%s is lent as a USB device: take it back and send as video" % d["name"])
                it.connect("activate", lambda _i, d=d: app.camera_from_usb(d))
                m.append(it)
            if not cams and not lent:
                self.head(m, "   No camera on this computer")
            m.append(Gtk.SeparatorMenuItem())
            self.head(m, "It appears there as \"%s\"." % C.CAMERA_LABEL)
            self.popup(m, widget)

        def sound_menu(self, widget):
            s, app = self.s, self.app
            o = dict(C.DEFAULT_OPTS, **s.opts)
            m = Gtk.Menu()

            def change(**kw):
                app.change_sound(s, kw)

            def radio(group, label, active, cb):
                it = Gtk.RadioMenuItem.new_with_label_from_widget(group, label)
                it.set_active(active)
                it.connect("toggled", lambda i: i.get_active() and cb())
                m.append(it)
                return it
            self.head(m, "Sound of %s" % s.name)
            here = o["sound"] and o.get("sound_where", "here") == "here"
            g = None
            speakers = C.list_audio("sinks")
            if speakers:
                for sp in speakers:
                    it = radio(g, "Play here: %s" % sp["title"], here and o.get("speaker_device") == sp["name"],
                               lambda sp=sp: change(sound=True, sound_where="here", speaker_device=sp["name"]))
                    g = g or it
                it = radio(g, "Play here: default speakers", here and not o.get("speaker_device"),
                           lambda: change(sound=True, sound_where="here", speaker_device=""))
            else:
                it = radio(g, "Play here", here, lambda: change(sound=True, sound_where="here"))
            g = g or it
            radio(g, "Play on %s's own speakers" % s.name, o["sound"] and o.get("sound_where") == "remote",
                  lambda: change(sound=True, sound_where="remote"))
            radio(g, "Off", not o["sound"], lambda: change(sound=False))
            m.append(Gtk.SeparatorMenuItem())
            self.head(m, "Microphone sent to %s" % s.name)
            g = None
            for mic in C.list_audio("sources"):
                it = radio(g, mic["title"], o["microphone"] and o.get("mic_device") == mic["name"],
                           lambda mic=mic: change(microphone=True, mic_device=mic["name"]))
                g = g or it
            it = radio(g, "Default microphone", o["microphone"] and not o.get("mic_device"),
                       lambda: change(microphone=True, mic_device=""))
            g = g or it
            radio(g, "Off", not o["microphone"], lambda: change(microphone=False))
            m.append(Gtk.SeparatorMenuItem())
            ec = Gtk.CheckMenuItem(label="Reduce echo and room noise")
            ec.set_active(bool(o.get("clean_mic")))
            ec.set_sensitive(bool(o["microphone"]))
            ec.connect("toggled", lambda i: change(clean_mic=i.get_active()))
            m.append(ec)
            self.head(m, "Changes reopen the desktop view for a moment.")
            self.popup(m, widget)

        def folder_menu(self, widget):
            s, app = self.s, self.app
            m = Gtk.Menu()
            it = Gtk.MenuItem(label="Open %s's folder" % s.name)
            it.set_sensitive(bool(s.mounted_theirs))
            it.connect("activate", lambda *_: app.open_path(s.mounted_theirs))
            m.append(it)
            it = Gtk.MenuItem(label="Open the shared folder of this computer")
            it.connect("activate", lambda *_: app.open_path(C.share_dir(app.cfg)))
            m.append(it)
            if not s.shared_mine:
                self.head(m, "This computer's folder isn't open on %s" % s.name)
            self.popup(m, widget)

        def on_disconnect(self, *_):
            self.app.disconnect_session()

        def on_close(self, *_):
            self.app.disconnect_session()
            return True

        def close_window(self):
            self.pop.destroy()
            self.destroy()

    class App(Gtk.Window):
        def __init__(self, auto_connect=None):
            super().__init__(title="PairDesk")
            apply_theme(C.load_config())
            try:   # fit the screen: 90 % of the work area, at most 860 x 720
                disp = Gdk.Display.get_default()
                mon = disp.get_primary_monitor() or disp.get_monitor(0)
                wa = mon.get_workarea()
                self.set_default_size(min(860, int(wa.width * 0.9)), min(720, int(wa.height * 0.9)))
            except (AttributeError, TypeError):
                self.set_default_size(820, 640)
            self.set_size_request(520, 420)
            self.set_icon_name("pairdesk")
            self.session = None
            self._pair_dialog_open = False
            self._seen_request = (C.load_config().get("pairing") or {}).get("request_id")
            try:
                with open(os.path.join(C.run_dir(), "gui.pid"), "w") as f:
                    f.write(str(os.getpid()))
            except OSError:
                pass
            GLib.timeout_add(1000, self.watch_requests)

            def revoked(names):
                if names:
                    self.cfg = C.load_config()
                    if not self.session:
                        self.refresh_peers()
                    self.refresh_paired()
                    self.notice("Pairing removed", "%s removed the pairing with the current computer, so it was "
                                "removed here too." % ", ".join(names))
            bg(C.cleanup_revoked, revoked, lambda e: None)
            if C.migrate_from_deskbridge() and C.load_config().get("mode") in ("server", "both"):
                try:
                    C.link_start()
                except C.DBError:
                    pass
            old = C.migrate_v2()
            if not C.pairing_open():
                C.stop_pairing()
            self.cfg = C.load_config()
            self._migrated = old
            self.remote_devs = []
            self.last_local = None
            self._quiet = False

            hb = Gtk.HeaderBar(show_close_button=True, title="PairDesk", subtitle=C.hostname())
            self.set_titlebar(hb)
            # status pill: is the current computer accepting connections?
            self.pill = Gtk.Button(relief=Gtk.ReliefStyle.NONE)
            self.pill.get_style_context().add_class("db-pill")
            self.pill.set_tooltip_text("Remote access settings")
            self.pill.connect("clicked", lambda *_: self.stack.set_visible_child_name("server"))
            hb.pack_end(self.pill)
            helpb = Gtk.MenuButton()
            ql = Gtk.Label()
            ql.set_markup("<b>?</b>")
            helpb.add(ql)
            helpb.set_tooltip_text("Help")
            menu = Gtk.Menu()
            for label, fn in (("Help topics…", lambda *_: self.show_help()),
                              ("Check this computer…", lambda *_: self.show_doctor()),
                              ("Welcome screen…", lambda *_: self.welcome()),
                              ("Set up a computer without a monitor…", lambda *_: self.headless_help()),
                              ("Open log file", lambda *_: self.open_path(C.log_file())),
                              ("About PairDesk", lambda *_: self.about())):
                it = Gtk.MenuItem(label=label)
                it.connect("activate", fn)
                menu.append(it)
            menu.show_all()
            helpb.set_popup(menu)
            hb.pack_end(helpb)

            outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            self.add(outer)
            self.info = Gtk.InfoBar(message_type=Gtk.MessageType.INFO, show_close_button=False)
            self.info_lbl = Gtk.Label(label="", xalign=0, wrap=True)
            self.info.get_content_area().add(self.info_lbl)
            self.info_btn = self.info.add_button("Set up USB sharing", 1)
            self.info.add_button("Not now", 2)
            self.info.connect("response", self.on_info_response)
            self.info.set_no_show_all(True)
            outer.pack_start(self.info, False, False, 0)

            self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
            sw = Gtk.StackSwitcher(stack=self.stack, halign=Gtk.Align.CENTER, margin=8)
            outer.pack_start(sw, False, False, 0)
            outer.pack_start(self.stack, True, True, 0)
            self.stack.add_titled(self.build_connect(), "connect", "Connect")
            self.stack.add_titled(self.scrolled(self.build_server()), "server", "Current computer")
            self.stack.add_titled(self.scrolled(self.build_settings()), "settings", "Settings")

            exp = Gtk.Expander(label="Activity", margin_start=12, margin_end=12, margin_bottom=6, margin_top=2)
            self.logbuf = Gtk.TextBuffer()
            tv = Gtk.TextView(buffer=self.logbuf, editable=False, monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR)
            scr = Gtk.ScrolledWindow(min_content_height=90)
            scr.add(tv)
            self.logview = tv
            exp.add(scr)
            outer.pack_end(exp, False, False, 0)

            self.connect("delete-event", self.on_close)
            self.show_all()
            self.apply_mode_visibility()
            self.refresh_peers()
            self.refresh_local()
            GLib.timeout_add_seconds(3, self.tick)
            bg(needs_setup, self.show_setup_state, lambda e: None)
            GLib.timeout_add(1200, self.offer_pending)
            if self._migrated:
                GLib.timeout_add(900, lambda: self.notice(
                    "Pair again once", "PairDesk 2.0 uses its own secure service and code pairing. "
                    "Pair %s again: on that computer press \"Pair a new computer\", then here \"Add remote "
                    "computer…\"." % ", ".join(self._migrated)) and False)
            if auto_connect:
                GLib.timeout_add(400, self.auto_connect, auto_connect)
            elif not (self.cfg.get("welcomed") or self.cfg["peers"] or self.cfg["incoming"]):
                GLib.timeout_add(500, lambda: self.welcome() and False)

        # --------------------------------------------------------- welcome and self-check
        def welcome(self):
            """First start: one question, what is this computer for? Then straight to the next step."""
            c = C.load_config()
            c["welcomed"] = True
            C.save_config(c)
            self.cfg["welcomed"] = True
            d = Gtk.Dialog(transient_for=self, modal=True, title="Welcome", resizable=False)
            d.set_size_request(min(560, self.get_allocated_width()), -1)
            box = d.get_content_area()
            box.set_spacing(10)
            box.set_border_width(20)
            head = Gtk.Box(spacing=14)
            head.pack_start(Gtk.Image.new_from_icon_name("pairdesk", Gtk.IconSize.DIALOG), False, False, 0)
            t = Gtk.Label(xalign=0, wrap=True)
            t.set_markup("<span size='x-large' weight='bold'>Welcome to PairDesk</span>\n"
                         "Use another computer as if you were sitting at it, with its desktop, sound, "
                         "folders and your USB devices.")
            head.pack_start(t, True, True, 0)
            box.pack_start(head, False, False, 0)
            q = Gtk.Label(xalign=0, margin_top=6)
            q.set_markup("<b>What will you do with %s?</b>" % GLib.markup_escape_text(C.hostname()))
            box.pack_start(q, False, False, 0)
            choice = {}

            def card(key, icon, title, text):
                b = Gtk.Button(relief=Gtk.ReliefStyle.NORMAL)
                b.get_style_context().add_class("db-choice")
                row = Gtk.Box(spacing=14, margin=10)
                row.pack_start(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.DND), False, False, 0)
                lab = Gtk.Label(xalign=0, wrap=True, max_width_chars=48)
                lab.set_markup("<b>%s</b>\n<small>%s</small>" % (title, text))
                row.pack_start(lab, True, True, 0)
                b.add(row)

                def pick(*_):
                    choice["k"] = key
                    d.response(1)
                b.connect("clicked", pick)
                box.pack_start(b, False, False, 0)
            card("reach", "video-display-symbolic", "Reach another computer from here",
                 "This is the computer you sit at. Next: add the other computer and pair with a code.")
            card("accept", "network-server-symbolic", "Reach this computer from another one",
                 "Turns on remote access. Next: pair the computer you'll sit at.")
            card("both", "view-dual-symbolic", "Both", "Each computer can reach the other.")
            tip = Gtk.Label(xalign=0, wrap=True, margin_top=4)
            tip.set_markup("<small>The other computer has no monitor? Help (?) > Set up a computer without a "
                           "monitor. You can open this screen again from Help.</small>")
            box.pack_start(tip, False, False, 0)
            d.add_button("Skip", 0)
            d.show_all()
            d.run()
            d.destroy()
            k = choice.get("k")
            if k in ("accept", "both") and not self.accepting():
                self.on_mode(None, "both")
            if k == "reach":
                self.stack.set_visible_child_name("connect")
                GLib.timeout_add(300, lambda: self.on_add() and False)
            elif k in ("accept", "both"):
                self.stack.set_visible_child_name("server")
                self.notice("Remote access is on", "Now pair the computer you'll sit at: open PairDesk there, "
                            "press + and choose this computer (or type its address, shown under Remote access), then "
                            "Next. A code appears here; type it there."
                            + ("\n\nThen press + here to add that computer too." if k == "both" else ""))
            return False

        def show_doctor(self):
            d = Gtk.Dialog(transient_for=self, modal=True, title="Check this computer")
            d.set_default_size(min(620, self.get_allocated_width()), min(560, self.get_allocated_height()))
            area = d.get_content_area()
            area.set_border_width(12)
            area.set_spacing(8)
            hdr = Gtk.Label(xalign=0)
            hdr.set_markup("<b>Checking…</b>")
            area.pack_start(hdr, False, False, 0)
            lb = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
            lb.get_style_context().add_class("db-card")
            sc = Gtk.ScrolledWindow(vexpand=True)
            sc.add(lb)
            area.pack_start(sc, True, True, 0)
            spin = Gtk.Spinner(active=True)
            area.pack_start(spin, False, False, 0)
            d.add_button("Copy report", 2)
            d.add_button("Check again", 1)
            d.add_button("Close", 0)
            pri(d, 0)
            icons = {"ok": ("emblem-ok-symbolic", "db-ok"), "warn": ("dialog-warning-symbolic", "db-warn"),
                     "bad": ("dialog-error-symbolic", "db-bad"), "info": ("dialog-information-symbolic", "db-info")}
            state = {"res": []}

            def show(res):
                state["res"] = res
                spin.stop()
                spin.hide()
                for ch in lb.get_children():
                    lb.remove(ch)
                for level, title, detail in res:
                    row = Gtk.Box(spacing=12, margin=8)
                    img = Gtk.Image.new_from_icon_name(icons[level][0], Gtk.IconSize.LARGE_TOOLBAR)
                    img.get_style_context().add_class(icons[level][1])
                    row.pack_start(img, False, False, 0)
                    lab = Gtk.Label(xalign=0, wrap=True, selectable=True, max_width_chars=60)
                    lab.set_markup("<b>%s</b>%s" % (GLib.markup_escape_text(title), (
                        "\n<small>%s</small>" % GLib.markup_escape_text(detail)) if detail else ""))
                    row.pack_start(lab, True, True, 0)
                    lb.add(row)
                n = sum(1 for r in res if r[0] in ("warn", "bad"))
                hdr.set_markup("<b>%s</b>" % ("Everything looks fine." if not n else
                                              "%d thing%s to look at" % (n, "" if n == 1 else "s")))
                lb.show_all()

            def run():
                spin.show()
                spin.start()
                bg(doctor, show, lambda e: hdr.set_text("The check failed: %s" % e))
            run()
            d.show_all()
            while True:
                r = d.run()
                if r == 1:
                    run()
                    continue
                if r == 2:
                    marks = {"ok": "OK  ", "warn": "!   ", "bad": "FAIL", "info": "    "}
                    txt = "\n".join("%s %s%s" % (marks[lv], t, (" - " + dt) if dt else "")
                                    for lv, t, dt in state["res"])
                    copy(txt, d.get_widget_for_response(2))
                    continue
                break
            d.destroy()

        def auto_connect(self, name):
            if name not in self.cfg["peers"]:
                self.error("PairDesk doesn't know a computer called %s." % name)
                return False
            self.stack.get_child_by_name("connect").set_visible(True)
            self.stack.set_visible_child_name("connect")
            self.refresh_peers(select=name)
            if not self.session:
                self.on_connect()
            return False

        # --------------------------------------------------------- helpers
        def log(self, msg):
            def add():
                self.logbuf.insert(self.logbuf.get_end_iter(), msg + "\n")
                self.logview.scroll_to_iter(self.logbuf.get_end_iter(), 0, False, 0, 0)
                self.status.set_text(msg)
            GLib.idle_add(add)

        def error(self, msg):
            C.flog("Error: " + msg)
            self.log("Error: " + msg)
            d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.ERROR,
                                  buttons=Gtk.ButtonsType.CLOSE, text="PairDesk")
            d.format_secondary_text(msg)
            d.run()
            d.destroy()

        def ensure(self, name, then, skip=None, context=None):
            """Run then() when the feature is installed; otherwise explain it and offer to install."""
            if C.feature_present(name):
                then()
                return
            f = C.FEATURES[name]
            d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                  text="Add %s?" % f["title"])
            d.format_secondary_text(((context + "\n\n") if context else "") + C.feature_text(name) +
                                    "\n\nYou'll be asked for your admin password.")
            d.add_button("Not now", 0)
            d.add_button("Install", 1)
            pri(d, 1)
            r = d.run()
            d.destroy()
            if r != 1:
                self.log("Skipped: %s is not installed." % f["title"])
                if skip:
                    skip()
                return
            self.with_progress(
                "Installing %s" % f["title"], "Waiting for your admin password…",
                lambda on_line: C.install_feature(name, on_line=on_line),
                lambda rep: ("Installed: %s" % ", ".join(rep["installed"])) if rep.get("installed")
                else "Already installed.",
                after=lambda _r: then(), on_fail=lambda _m: skip and skip())

        def with_progress(self, title, intro, fn, ok_msg, after=None, on_fail=None):
            """Run fn(on_line) in the background with a progress window."""
            pw = Progress(self, title, intro)

            def done(res):
                pw.finish(True, ok_msg(res) if callable(ok_msg) else ok_msg)
                self.log(title + ": done.")
                if after:
                    after(res)

            def failed(msg):
                pw.finish(False, msg)
                self.log(title + ": " + msg)
                if on_fail:
                    on_fail(msg)
            bg(lambda: fn(pw.line), done, failed)
            return pw

        def ensure_all(self, items, then):
            """items: [(feature, context, on_skip)]; asks for each missing one in turn."""
            if not items:
                then()
                return
            name, ctx, on_skip = items[0]
            rest = lambda: self.ensure_all(items[1:], then)  # noqa: E731
            self.ensure(name, rest, skip=lambda: (on_skip and on_skip(), rest()), context=ctx)

        def notice(self, title, msg):
            C.flog(msg)
            self.log(msg)
            d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.INFO,
                                  buttons=Gtk.ButtonsType.OK, text=title)
            d.format_secondary_text(msg)
            d.run()
            d.destroy()

        def save(self):
            C.save_config(self.cfg)

        def peer(self):
            n = self.peer_combo.get_active_text()
            return n, self.cfg["peers"].get(n)

        @staticmethod
        def frame(title, child):
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_start=12, margin_end=12,
                           margin_top=6, margin_bottom=6)
            card.get_style_context().add_class("db-card")
            t = Gtk.Label(label=title, xalign=0)
            t.get_style_context().add_class("db-card-title")
            card.pack_start(t, False, False, 0)
            card.pack_start(child, True, True, 0)
            return card

        @staticmethod
        def scrolled(child):
            sw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER,
                                    vscrollbar_policy=Gtk.PolicyType.AUTOMATIC)
            sw.add(child)
            return sw

        @staticmethod
        def well(child):
            sw = Gtk.ScrolledWindow(min_content_height=110, hscrollbar_policy=Gtk.PolicyType.NEVER)
            sw.add(child)
            sw.get_style_context().add_class("db-well")
            return sw

        @staticmethod
        def flow(widgets, max_cols=3, homogeneous=True):
            fb = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=homogeneous,
                             max_children_per_line=max_cols, min_children_per_line=1,
                             column_spacing=18, row_spacing=4)
            for w in widgets:
                fb.add(w)
            return fb

        # --------------------------------------------------------- Connect page
        def build_connect(self):
            page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)

            # one row: who, Connect, add
            top = Gtk.Box(spacing=8)
            self.peer_combo = Gtk.ComboBoxText()
            self.peer_combo.connect("changed", lambda *_: self.on_peer_changed())
            top.pack_start(self.peer_combo, True, True, 0)
            self.conn_btn = Gtk.Button(label="Connect")
            self.conn_btn.get_style_context().add_class("suggested-action")
            self.conn_btn.set_size_request(130, -1)
            self.conn_btn.connect("clicked", lambda *_: self.on_connect())
            top.pack_start(self.conn_btn, False, False, 0)
            add = Gtk.Button.new_from_icon_name("list-add-symbolic", Gtk.IconSize.BUTTON)
            add.set_tooltip_text("Add a remote computer")
            add.connect("clicked", lambda *_: self.on_add())
            top.pack_start(add, False, False, 0)
            self.empty_hint = Gtk.Label(xalign=0, wrap=True)
            self.empty_hint.set_markup("<small>No computers yet. Press <b>+</b> to add one with the address and "
                                       "code shown on it.</small>")
            self.empty_hint.get_style_context().add_class("db-muted")
            self.empty_hint.set_no_show_all(True)
            head = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            head.pack_start(top, False, False, 0)
            head.pack_start(self.empty_hint, False, False, 0)
            page.pack_start(self.frame("Remote computer", head), False, False, 0)

            # options, folded away with a one-line summary
            self.opt_checks = {}
            labels = [("desktop", "Full desktop"), ("fullscreen", "Full screen"), ("sound", "Remote sound on current computer"),
                      ("microphone", "Current microphone on remote"), ("clipboard", "Shared clipboard"),
                      ("multimon", "Use all current monitors"), ("share_mine", "Share current folder with remote"),
                      ("open_theirs", "Open remote shared folder"), ("printers", "Current printers on remote"),
                      ("direct_desktop", "Direct desktop stream (faster on slow computers)")]
            self.opt_labels = dict(labels)
            for k, lbl in labels:
                cb = Gtk.CheckButton(label=lbl)
                cb.connect("toggled", self.on_opt, k)
                self.opt_checks[k] = cb
            qb = Gtk.Box(spacing=8)
            qb.pack_start(Gtk.Label(label="Picture"), False, False, 0)
            self.quality = Gtk.ComboBoxText()
            for k, lbl in (("best", "Best (wired network)"), ("auto", "Automatic"), ("fast", "Fast (weak Wi-Fi)")):
                self.quality.append(k, lbl)
            self.quality.connect("changed", self.on_quality)
            qb.pack_start(self.quality, False, False, 0)
            sb = Gtk.Box(spacing=12)
            self.menu_chk = Gtk.CheckButton(label="In app menu")
            self.menu_chk.set_tooltip_text('Adds "PairDesk: <name>" to your applications for one-click connect')
            self.auto_chk = Gtk.CheckButton(label="Connect when I log in")
            for cb, kind in ((self.menu_chk, "menu"), (self.auto_chk, "autostart")):
                cb.connect("toggled", self.on_launcher, kind)
                sb.pack_start(cb, False, False, 0)
            opts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=6)
            opts.pack_start(self.flow([self.opt_checks[k] for k, _ in labels]), False, False, 0)
            opts.pack_start(self.flow([qb, sb], max_cols=2, homogeneous=False), False, False, 0)
            # sound devices of this computer for the remote desktop
            ag = Gtk.Grid(column_spacing=8, row_spacing=6)
            self.spk_combo, self.mic_combo = Gtk.ComboBoxText(), Gtk.ComboBoxText()
            self.where_combo = Gtk.ComboBoxText()
            for k, lbl in (("here", "Plays here"), ("remote", "Plays on the remote computer")):
                self.where_combo.append(k, lbl)
            ag.attach(Gtk.Label(label="Remote sound", xalign=0), 0, 0, 1, 1)
            ag.attach(self.where_combo, 1, 0, 1, 1)
            ag.attach(self.spk_combo, 2, 0, 1, 1)
            ag.attach(Gtk.Label(label="Microphone sent", xalign=0), 0, 1, 1, 1)
            ag.attach(self.mic_combo, 1, 1, 2, 1)
            self.clean_chk = Gtk.CheckButton(label="Reduce echo and room noise")
            ag.attach(self.clean_chk, 1, 2, 2, 1)
            for w, key in ((self.spk_combo, "speaker_device"), (self.mic_combo, "mic_device"),
                           (self.where_combo, "sound_where")):
                w.connect("changed", self.on_audio_choice, key)
            self.clean_chk.connect("toggled", lambda b: self.on_audio_choice(b, "clean_mic"))
            opts.pack_start(ag, False, False, 0)
            self.opt_exp = Gtk.Expander()
            self.opt_sum = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
            self.opt_exp.set_label_widget(self.opt_sum)
            self.opt_exp.add(opts)
            page.pack_start(self.frame("Options", self.opt_exp), False, False, 0)

            # USB devices
            left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            left.pack_start(Gtk.Label(label="Current computer → send to remote", xalign=0), False, False, 0)
            self.local_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
            left.pack_start(self.well(self.local_list), True, True, 0)
            right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            rh = Gtk.Box(spacing=4)
            self.remote_title = Gtk.Label(label="Remote computer → use on current", xalign=0)
            rh.pack_start(self.remote_title, True, True, 0)
            rb = Gtk.Button.new_from_icon_name("view-refresh-symbolic", Gtk.IconSize.BUTTON)
            rb.set_relief(Gtk.ReliefStyle.NONE)
            rb.set_tooltip_text("Refresh remote computer's devices")
            rb.connect("clicked", lambda *_: self.refresh_remote())
            rh.pack_start(rb, False, False, 0)
            right.pack_start(rh, False, False, 0)
            self.remote_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
            right.pack_start(self.well(self.remote_list), True, True, 0)
            usb = self.flow([left, right], max_cols=2)     # side by side, or stacked on narrow windows
            page.pack_start(self.frame("USB devices", usb), True, True, 0)

            # slim status line
            bottom = Gtk.Box(spacing=10)
            bottom.get_style_context().add_class("db-bar")
            self.status = Gtk.Label(label="Not connected", xalign=0, ellipsize=Pango.EllipsizeMode.END)
            self.status.get_style_context().add_class("db-muted")
            bottom.pack_start(self.status, True, True, 0)
            self.folder_btn = Gtk.Button(label="Open remote folder", sensitive=False)
            self.folder_btn.set_tooltip_text("Opens the remote computer's shared folder once you're connected")
            self.folder_btn.connect("clicked", lambda *_: self.open_path(
                self.session.mounted_theirs if self.session else None))
            self.folder_btn.set_no_show_all(True)
            bottom.pack_end(self.folder_btn, False, False, 0)
            wrap = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            wrap.pack_start(self.scrolled(page), True, True, 0)
            wrap.pack_end(bottom, False, False, 0)
            return wrap

        def update_opt_summary(self):
            on = [k for k in ("desktop", "sound", "microphone", "clipboard", "share_mine", "open_theirs", "printers")
                  if self.opt_checks[k].get_active()]
            short = {"desktop": "desktop", "sound": "sound", "microphone": "microphone", "clipboard": "clipboard",
                     "share_mine": "folders", "open_theirs": "folders", "printers": "printers"}
            words = []
            for k in on:
                if short[k] not in words:
                    words.append(short[k])
            self.opt_sum.set_text(("Sharing: " + ", ".join(words)) if words else "Sharing: nothing selected")

        def refresh_peers(self, select=None):
            cur = select or self.peer_combo.get_active_text()
            self.peer_combo.remove_all()
            names = sorted(self.cfg["peers"])
            for n in names:
                self.peer_combo.append_text(n)
            if names:
                self.peer_combo.set_active(names.index(cur) if cur in names else 0)
            self.on_peer_changed()

        def on_peer_changed(self):
            n, p = self.peer()
            self._quiet = True
            for k, cb in self.opt_checks.items():
                cb.set_active(bool((p or {}).get("opts", C.DEFAULT_OPTS).get(k)))
                cb.set_sensitive(p is not None)
            self.quality.set_active_id((p or {}).get("opts", {}).get("quality", "auto"))
            self.quality.set_sensitive(p is not None)
            self.fill_audio(p)
            for cb, kind in ((self.menu_chk, "menu"), (self.auto_chk, "autostart")):
                cb.set_active(bool(n) and os.path.exists(C.launcher_path(n, kind)))
                cb.set_sensitive(p is not None)
            self._quiet = False
            self.empty_hint.set_visible(not self.cfg["peers"])
            self.update_opt_summary()
            self.conn_btn.set_sensitive(p is not None or self.session is not None)
            self.remote_title.set_text("Remote: %s → use on current" % n if n else "Remote computer → use on current")
            self.refresh_local(force=True)
            self.fill_remote()

        def on_opt(self, cb, key):
            if hasattr(self, "opt_sum"):
                self.update_opt_summary()
            if self._quiet:
                return
            n, p = self.peer()
            if p:
                p.setdefault("opts", dict(C.DEFAULT_OPTS))[key] = cb.get_active()
                self.opts_saved(n, p)

        def fill_audio(self, p):
            """The sound devices of this computer, with the remote computer's choice selected."""
            o = dict(C.DEFAULT_OPTS, **((p or {}).get("opts") or {}))
            was = self._quiet
            self._quiet = True
            for combo, kind, key, first in ((self.spk_combo, "sinks", "speaker_device", "Default speakers"),
                                            (self.mic_combo, "sources", "mic_device", "Default microphone")):
                combo.remove_all()
                combo.append("", first)
                for dev in C.list_audio(kind):
                    combo.append(dev["name"], dev["title"])
                if o.get(key) and not combo.set_active_id(o[key]):
                    combo.append(o[key], "%s (not connected now)" % o[key])
                combo.set_active_id(o.get(key) or "")
            self.where_combo.set_active_id(o.get("sound_where") or "here")
            self.clean_chk.set_active(bool(o.get("clean_mic")))
            for w in (self.spk_combo, self.mic_combo, self.where_combo, self.clean_chk):
                w.set_sensitive(p is not None)
            self._quiet = was

        def on_audio_choice(self, w, key):
            if self._quiet:
                return
            n, p = self.peer()
            if not p:
                return
            val = w.get_active() if key == "clean_mic" else (w.get_active_id() or "")
            p.setdefault("opts", dict(C.DEFAULT_OPTS))[key] = val
            self.opts_saved(n, p)
            s = self.session
            if s and s.name == n and getattr(s, "rdp", None):
                bg(lambda: s.reopen_desktop({key: val}))

        def on_quality(self, combo):
            if self._quiet:
                return
            n, p = self.peer()
            if p:
                p.setdefault("opts", dict(C.DEFAULT_OPTS))["quality"] = combo.get_active_id()
                self.opts_saved(n, p)

        def opts_saved(self, n, p):
            """Options are kept per computer as soon as they change; new computers start with the latest."""
            self.cfg["default_opts"] = dict(p["opts"])
            self.save()
            if self.session is None:
                self.status.set_text("Saved for %s. Newly paired computers start with these options too." % n)

        def on_launcher(self, cb, kind):
            if self._quiet:
                return
            n, p = self.peer()
            if p:
                C.set_launcher(n, kind, cb.get_active())
                self.log(("Added" if cb.get_active() else "Removed") +
                         (" app-menu entry for %s." if kind == "menu" else " auto-connect at login for %s.") % n)

        def open_path(self, path):
            if path:
                subprocess.Popen(["xdg-open", path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        def usb_row(self, dev, active, on_toggle, note="", enabled=True):
            row = Gtk.ListBoxRow()
            b = Gtk.Box(spacing=8, margin=4)
            icon = {"camera": "camera-web-symbolic", "storage": "drive-removable-media-symbolic",
                    "security key": "dialog-password-symbolic", "keyboard": "input-keyboard-symbolic",
                    "mouse": "input-mouse-symbolic", "touchscreen": "input-tablet-symbolic",
                    "input device": "input-gaming-symbolic", "audio": "audio-card-symbolic",
                    "printer": "printer-symbolic"}.get(dev["kind"], "drive-harddisk-usb-symbolic")
            b.pack_start(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.LARGE_TOOLBAR), False, False, 0)
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            t = Gtk.Label(label=dev["name"], xalign=0, ellipsize=Pango.EllipsizeMode.END)
            v.pack_start(t, False, False, 0)
            sub = Gtk.Label(xalign=0)
            sub.set_markup("<small>%s · %s%s</small>" % (dev["kind"], dev["usbid"],
                                                       GLib.markup_escape_text(note)))
            sub.get_style_context().add_class("dim-label")
            v.pack_start(sub, False, False, 0)
            b.pack_start(v, True, True, 0)
            sw = Gtk.Switch(active=active, valign=Gtk.Align.CENTER, sensitive=enabled)
            if not enabled:
                sw.set_tooltip_text("USB sharing needs the optional setup (Settings > Set up USB sharing)")
            sw.connect("notify::active", lambda s, _p: on_toggle(dev, s))
            b.pack_end(sw, False, False, 0)
            row.add(b)
            return row

        def refresh_local(self, force=False):
            devs = C.list_local_usb()
            sig = [(d["busid"], d["key"], d["exported"]) for d in devs] + \
                sorted(self.session.usb_failed if self.session else [])
            if sig == self.last_local and not force:
                return devs
            self.last_local = sig
            for ch in self.local_list.get_children():
                self.local_list.remove(ch)
            n, p = self.peer()
            send = set((p or {}).get("usb_send", []))
            sent = {x["key"] for x in self.session.sent.values()} if self.session else set()
            ok = getattr(self, "usb_ok", True)
            failed = self.session.usb_failed if self.session else {}
            for d in devs:
                note = "  · on remote %s now" % n if d["key"] in sent else ("" if ok else "  · needs setup")
                if d["busid"] in failed:
                    note = "  · didn't work, flip to retry"
                elif d["kind"] == "camera" and d["key"] not in sent:
                    note += "  · smoother: Camera button in the desktop toolbar"
                self.local_list.add(self.usb_row(d, d["key"] in send, self.on_local_toggle, note, enabled=ok))
            if not devs:
                self.local_list.add(Gtk.Label(label="No USB devices found", margin=10))
            self.local_list.show_all()
            return devs

        def fill_remote(self):
            for ch in self.remote_list.get_children():
                self.remote_list.remove(ch)
            n, p = self.peer()
            take = set((p or {}).get("usb_take", []))
            if not self.session or self.session.name != n:
                for k in sorted(take):
                    self.remote_list.add(Gtk.Label(label="%s (used on current computer when connected)" % k, xalign=0, margin=6))
                self.remote_list.add(Gtk.Label(label="Connect to see remote devices", margin=10))
            else:
                taken = {x["key"] for x in self.session.taken.values()}
                ok = getattr(self, "usb_ok", True) and self.session.info.get("usb_ready", True)
                if not self.session.info.get("usb_ready", True):
                    self.remote_list.add(Gtk.Label(label="USB sharing isn't set up on %s" % n, margin=6))
                for d in self.remote_devs:
                    note = "  · on current computer now" if d["key"] in taken else ""
                    self.remote_list.add(self.usb_row(d, d["key"] in take, self.on_remote_toggle, note, enabled=ok))
                if not self.remote_devs:
                    self.remote_list.add(Gtk.Label(label="No USB devices on remote computer", margin=10))
            self.remote_list.show_all()

        def refresh_remote(self):
            if not self.session:
                return
            s = self.session
            bg(s.remote_usb, lambda devs: (setattr(self, "remote_devs", devs), self.fill_remote()))

        def on_local_toggle(self, dev, sw):
            if self.set_local_usb(dev, sw.get_active()) is False:
                sw.set_active(False)

        def set_local_usb(self, dev, on):
            """Send a device of this computer to the remote one (and remember it), or take it back."""
            n, p = self.peer()
            if self.session:
                n, p = self.session.name, self.cfg["peers"].get(self.session.name)
            if not p:
                return None
            lst = p.setdefault("usb_send", [])
            if on and C.is_my_input(dev) and dev["key"] not in lst:
                d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                                      buttons=Gtk.ButtonsType.OK_CANCEL, text="Send your %s to %s?" % (dev["kind"], n))
                d.format_secondary_text("While it's shared you can't use %s on the current computer. "
                                        "Only do this for a spare %s." % (dev["name"], dev["kind"]))
                ok = d.run() == Gtk.ResponseType.OK
                d.destroy()
                if not ok:
                    return False
            if on and dev["key"] not in lst:
                lst.append(dev["key"])
            if not on and dev["key"] in lst:
                lst.remove(dev["key"])
            self.save()
            s = self.session
            if s and s.name == n:
                s.usb_failed.pop(dev["busid"], None)       # flipped again: try again
                if on and dev["busid"] not in s.sent:
                    bg(lambda: s.send_usb(dev), lambda _r: self.refresh_local(force=True),
                       lambda m: (self.refresh_local(force=True), self.error(m)))
                elif not on and dev["busid"] in s.sent:
                    bg(lambda: s.recall_usb(dev["busid"]), lambda _r: self.refresh_local(force=True))
            return True

        def on_remote_toggle(self, dev, sw):
            self.set_remote_usb(dev, sw.get_active())

        def set_remote_usb(self, dev, on):
            """Use a device of the remote computer here (and remember it), or give it back."""
            n, p = self.peer()
            if self.session:
                n, p = self.session.name, self.cfg["peers"].get(self.session.name)
            if not p:
                return
            lst = p.setdefault("usb_take", [])
            if on and dev["key"] not in lst:
                lst.append(dev["key"])
            if not on and dev["key"] in lst:
                lst.remove(dev["key"])
            self.save()
            s = self.session
            if s and s.name == n:
                if on and dev["busid"] not in s.taken:
                    bg(lambda: s.take_usb(dev), lambda _r: self.refresh_remote())
                elif not on and dev["busid"] in s.taken:
                    bg(lambda: s.return_usb(dev["busid"]), lambda _r: self.refresh_remote())

        def watch_requests(self):
            try:
                mt = os.path.getmtime(os.path.join(C.cfg_dir(), "config.json"))
            except OSError:
                mt = 0
            if mt != getattr(self, "_cfg_mtime", mt):
                fresh = C.load_config()
                if (set(fresh["peers"]), set(fresh["incoming"])) != (set(self.cfg["peers"]), set(self.cfg["incoming"])):
                    self.cfg["peers"], self.cfg["incoming"] = fresh["peers"], fresh["incoming"]
                    if not self.session:
                        self.refresh_peers()
                    self.refresh_paired()
            self._cfg_mtime = mt
            pr = C.load_config().get("pairing") or {}
            rid = pr.get("request_id")
            if rid and rid != self._seen_request and pr.get("expires", 0) > time.time():
                self._seen_request = rid
                if not self._pair_dialog_open:
                    GLib.idle_add(lambda: self.pair_new(C.fmt_code(pr["code"]), pr.get("requested_by")) and False)
            return True

        def tick(self):
            devs = self.refresh_local()
            s = self.session
            if s:
                if s.state != "connected" or s.closing or not getattr(self, "usb_ok", True) \
                        or not s.info.get("usb_ready", True):
                    return True
                # devices plugged in during the session that are marked "send"
                for d in devs:
                    if d["key"] in s.p.get("usb_send", []) and d["busid"] not in s.sent and not d["exported"] \
                            and d["busid"] not in s.usb_failed:
                        bg(lambda d=d: s.send_usb(d), lambda _r: self.refresh_local(force=True))
            return True

        # --------------------------------------------------------- pairing
        def on_add(self):
            """Add a remote computer, step by step: find it (or type any form of its address), PairDesk
            fills in the rest and asks it for a code, type the code, connect. Every problem says what to do."""
            esc = GLib.markup_escape_text
            d = Gtk.Dialog(title="Add a remote computer", transient_for=self, modal=True)
            d.set_default_size(min(560, max(420, self.get_allocated_width() - 40)), -1)
            BACK, NEXT = 1, 2
            cancel = d.add_button("Cancel", Gtk.ResponseType.CANCEL)
            back = d.add_button("Back", BACK)
            nxt = d.add_button("Next", NEXT)
            nxt.get_style_context().add_class("suggested-action")
            nxt.set_can_default(True)
            d.set_default_response(NEXT)
            area = d.get_content_area()
            for m in ("set_margin_start", "set_margin_end", "set_margin_top"):
                getattr(area, m)(18)
            area.set_margin_bottom(8)
            stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.SLIDE_LEFT_RIGHT, vhomogeneous=False,
                              transition_duration=180)
            area.pack_start(stack, True, True, 0)
            st = {"page": "find", "target": None, "headless": False, "closed": False, "history": []}

            def page(name, title, sub=None):
                b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
                h = Gtk.Label(xalign=0, wrap=True, max_width_chars=58)
                h.set_markup("<span size='large' weight='bold'>%s</span>" % title)
                b.pack_start(h, False, False, 0)
                sl = Gtk.Label(xalign=0, wrap=True, max_width_chars=60)
                if sub:
                    sl.set_markup(sub)
                b.pack_start(sl, False, False, 0)
                stack.add_named(b, name)
                return b, h, sl

            # 1. find
            pf, _h, _s = page("find", "Which computer do you want to reach?",
                              "PairDesk looks for computers on your network that have remote access turned on.")
            lb = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE, activate_on_single_click=False)
            sc = Gtk.ScrolledWindow(min_content_height=150, hscrollbar_policy=Gtk.PolicyType.NEVER)
            sc.add(lb)
            sc.get_style_context().add_class("db-well")
            pf.pack_start(sc, True, True, 0)
            again = Gtk.Button(label="Look again", halign=Gtk.Align.START, relief=Gtk.ReliefStyle.NONE)
            again.get_style_context().add_class("db-link")
            pf.pack_start(again, False, False, 0)
            pf.pack_start(Gtk.Label(label="Or type its address:", xalign=0), False, False, 0)
            entry = Gtk.Entry(placeholder_text="e.g. 192.168.1.20", activates_default=True)
            pf.pack_start(entry, False, False, 0)
            hint = Gtk.Label(xalign=0, wrap=True, max_width_chars=60)
            hint.set_markup("<small>The address is shown on that computer: PairDesk &gt; Current computer &gt; "
                            "Address. A computer name works too, e.g. office-pc.local.</small>")
            hint.get_style_context().add_class("db-muted")
            pf.pack_start(hint, False, False, 0)

            # 2. busy
            pb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, valign=Gtk.Align.CENTER)
            spin = Gtk.Spinner()
            spin.set_size_request(32, 32)
            busy = Gtk.Label(wrap=True, max_width_chars=50, justify=Gtk.Justification.CENTER)
            pb.pack_start(spin, False, False, 18)
            pb.pack_start(busy, False, False, 0)
            stack.add_named(pb, "busy")

            # 3. problem
            pp, ph, ps = page("problem", "")
            ps.set_selectable(True)
            # offered when PairDesk doesn't answer but the computer accepts normal SSH logins
            sshbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=6)
            sshbox.pack_start(Gtk.Separator(), False, False, 4)
            sshlab = Gtk.Label(xalign=0, wrap=True, max_width_chars=60)
            sshbox.pack_start(sshlab, False, False, 0)
            srow = Gtk.Box(spacing=8)
            srow.pack_start(Gtk.Label(label="SSH login"), False, False, 0)
            slogin = Gtk.Entry(hexpand=True)
            srow.pack_start(slogin, True, True, 0)
            sgo = Gtk.Button(label="Set it up over SSH")
            sgo.get_style_context().add_class("suggested-action")
            srow.pack_start(sgo, False, False, 0)
            sshbox.pack_start(srow, False, False, 0)
            sstat = Gtk.Label(xalign=0, wrap=True, max_width_chars=60, selectable=True)
            sshbox.pack_start(sstat, False, False, 0)
            sshbox.set_no_show_all(True)
            pp.pack_start(sshbox, False, False, 0)

            # 4. user name (older PairDesk on the other computer, or another SSH server on that port)
            pu, uh, us = page("user", "What's your user name on that computer?",
                              "That computer doesn't say it by itself (it may have an older PairDesk). It's "
                              "the name you sign in with there.")
            uentry = Gtk.Entry(text=C.getpass_user(), activates_default=True)
            pu.pack_start(uentry, False, False, 0)
            uerr = Gtk.Label(xalign=0, wrap=True, max_width_chars=60)
            pu.pack_start(uerr, False, False, 0)

            # 5. code
            pc, ch, cs = page("code", "")
            hbox = Gtk.Box(spacing=8)
            hcmd = Gtk.Label(xalign=0, selectable=True)
            hcopy = Gtk.Button(label="Copy")
            hbox.pack_start(hcmd, False, False, 0)
            hbox.pack_start(hcopy, False, False, 0)
            hbox.set_no_show_all(True)
            pc.pack_start(hbox, False, False, 0)
            centry = Gtk.Entry(placeholder_text="XXXX-XXXX-XXXX-XXXX", activates_default=True, max_length=24,
                               width_chars=22, halign=Gtk.Align.START)
            centry.get_style_context().add_class("db-code")
            centry.set_icon_from_icon_name(Gtk.EntryIconPosition.SECONDARY, "view-conceal-symbolic")
            centry.set_icon_tooltip_text(Gtk.EntryIconPosition.SECONDARY, "Hide the code")

            def eye(e, _pos, _ev):
                e.set_visibility(not e.get_visibility())
                e.set_icon_from_icon_name(Gtk.EntryIconPosition.SECONDARY, "view-conceal-symbolic"
                                          if e.get_visibility() else "view-reveal-symbolic")
                e.set_icon_tooltip_text(Gtk.EntryIconPosition.SECONDARY, "Hide the code" if e.get_visibility()
                                        else "Show the code")
            centry.connect("icon-press", eye)
            pc.pack_start(centry, False, False, 0)
            cerr = Gtk.Label(xalign=0, wrap=True, max_width_chars=60)
            pc.pack_start(cerr, False, False, 0)
            newcode = Gtk.Button(label="Show the code again", halign=Gtk.Align.START, relief=Gtk.ReliefStyle.NONE)
            newcode.get_style_context().add_class("db-link")
            pc.pack_start(newcode, False, False, 0)
            # with SSH access to the other computer: fetch the code instead of reading its screen
            viassh = Gtk.Button(label="Can't see its screen? Pair over SSH (no code to type)", halign=Gtk.Align.START,
                                relief=Gtk.ReliefStyle.NONE)
            viassh.get_style_context().add_class("db-link")
            pc.pack_start(viassh, False, False, 0)
            grow = Gtk.Box(spacing=8)
            grow.pack_start(Gtk.Label(label="SSH login"), False, False, 0)
            glogin = Gtk.Entry(hexpand=True)
            grow.pack_start(glogin, True, True, 0)
            gget = Gtk.Button(label="Pair over SSH")
            gget.set_tooltip_text("Signs in with that computer's SSH password (asked once, not saved), gets a "
                                  "one-time code there and pairs with it")
            grow.pack_start(gget, False, False, 0)
            grow.set_no_show_all(True)
            pc.pack_start(grow, False, False, 0)
            gstat = Gtk.Label(xalign=0, wrap=True, max_width_chars=60)
            pc.pack_start(gstat, False, False, 0)
            safe = Gtk.Label(xalign=0, wrap=True, max_width_chars=60)
            SAFE_CODE = ("<small>No passwords are sent. Both computers prove they know the code, so nobody in "
                         "between can take part. A code works once, for 10 minutes, with 3 tries.</small>")
            SAFE_SSH = ("<small>Your SSH password goes only to that computer's own SSH login, typed in PairDesk's "
                        "window, and isn't saved. PairDesk gets a one-time code there and pairs with it, so nobody "
                        "in between can take part.</small>")
            safe.set_markup(SAFE_CODE)
            safe.get_style_context().add_class("db-muted")
            pc.pack_start(safe, False, False, 0)

            # 6. done
            pd, dh, ds = page("done", "")

            def show(name, busy_text=None):
                st["page"] = name
                if busy_text is not None:
                    busy.set_text(busy_text)
                    spin.start()
                else:
                    spin.stop()
                stack.set_visible_child_name(name)
                back.set_visible(name in ("problem", "user", "code"))
                cancel.set_label("Close" if name == "done" else "Cancel")
                nxt.set_visible(name != "busy")
                nxt.set_label({"problem": "Try again", "code": "Pair", "done": "Connect now"}.get(name, "Next"))
                update_next()
                if name == "find":
                    (entry if entry.get_text() or not lb.get_selected_row() else lb).grab_focus()
                elif name == "user":
                    uentry.grab_focus()
                elif name == "code":
                    centry.grab_focus()
                elif name == "done":
                    nxt.grab_focus()

            def update_next(*_):
                p_ = st["page"]
                ok = True
                if p_ == "find":
                    ok = bool(entry.get_text().strip()) or lb.get_selected_row() is not None
                elif p_ == "user":
                    ok = bool(uentry.get_text().strip())
                elif p_ == "code":
                    ok = len(C._norm_code(centry.get_text())) == 16
                nxt.set_sensitive(ok)

            def alive():
                return not st["closed"]

            # ---- finding computers
            def scan(*_):
                for ch_ in lb.get_children():
                    lb.remove(ch_)
                row = Gtk.Box(spacing=10, margin=12)
                sp = Gtk.Spinner(active=True)
                row.pack_start(sp, False, False, 0)
                row.pack_start(Gtk.Label(label="Looking on your network…", xalign=0), False, False, 0)
                lb.set_placeholder(row)
                row.show_all()
                again.set_sensitive(False)
                bg(C.find_computers, found, lambda e: found([]))

            def found(res):
                if not alive():
                    return False
                again.set_sensitive(True)
                for ch_ in lb.get_children():
                    lb.remove(ch_)
                known = set(self.cfg["peers"])
                if not res:
                    ph_ = Gtk.Label(wrap=True, max_width_chars=50, margin=14, justify=Gtk.Justification.CENTER)
                    ph_.set_markup("No computer with remote access on was found.\n<small>Type its address below, "
                                   "or turn on remote access there (PairDesk &gt; Current computer).</small>")
                    ph_.show()
                    lb.set_placeholder(ph_)
                for r in res:
                    row = Gtk.ListBoxRow()
                    row.target = r
                    b = Gtk.Box(spacing=12, margin=8)
                    b.pack_start(Gtk.Image.new_from_icon_name("computer-symbolic", Gtk.IconSize.LARGE_TOOLBAR),
                                 False, False, 0)
                    lab = Gtk.Label(xalign=0)
                    lab.set_markup("<b>%s</b>%s\n<small>%s</small>" % (
                        esc(r["name"]), "  <small>(already paired)</small>" if r["name"] in known else "",
                        esc("%s · %s" % (r["user"], r["host"]))))
                    b.pack_start(lab, True, True, 0)
                    row.add(b)
                    lb.add(row)
                lb.show_all()
                if len(res) == 1 and not entry.get_text().strip():
                    lb.select_row(lb.get_row_at_index(0))
                update_next()
                return False

            def picked(*_):
                if lb.get_selected_row() is not None and entry.get_text():
                    entry.set_text("")
                update_next()

            def typed(*_):
                if entry.get_text() and lb.get_selected_row() is not None:
                    lb.unselect_all()
                update_next()
            lb.connect("row-selected", picked)
            lb.connect("row-activated", lambda *_: go_next())
            entry.connect("changed", typed)
            uentry.connect("changed", update_next)

            def code_changed(*_):
                cerr.set_text("")
                update_next()
            centry.connect("changed", code_changed)
            again.connect("clicked", scan)

            # ---- steps
            def problem(title, body, ssh_target=None):
                ph.set_markup("<span size='large' weight='bold'>%s</span>" % esc(title))
                ps.set_markup(body)
                st["ssh_target"] = ssh_target
                if ssh_target:
                    sshlab.set_markup(
                        "<b>%s accepts SSH logins, so PairDesk can set it up from here.</b> In a terminal it "
                        "installs PairDesk there if it's missing or older, turns on remote access and offers the "
                        "other steps it needs, asking before each change. You sign in with that computer's "
                        "password." % esc(ssh_target["host"]))
                    slogin.set_text("%s@%s" % (ssh_target.get("user") or C.getpass_user(), ssh_target["host"]))
                    sstat.set_text("")
                    sgo.set_sensitive(True)
                    sshbox.set_no_show_all(False)
                    sshbox.show_all()
                else:
                    sshbox.hide()
                show("problem")

            def ssh_setup(*_):
                login = slogin.get_text().strip()
                if "@" not in login:
                    login = "%s@%s" % (C.getpass_user(), login)
                deb = C.local_package_file()
                if not deb:
                    fc = Gtk.FileChooserNative.new("Choose the PairDesk .deb file to install there", d,
                                                   Gtk.FileChooserAction.OPEN, "Use this file", "Cancel")
                    flt = Gtk.FileFilter()
                    flt.set_name("PairDesk package (pairdesk_*.deb)")
                    flt.add_pattern("pairdesk_*.deb")
                    fc.add_filter(flt)
                    if fc.run() != Gtk.ResponseType.ACCEPT:
                        sstat.set_text("Choose the pairdesk .deb file (the one you installed here) to continue.")
                        return
                    deb = fc.get_filename()
                ver = subprocess.run(["dpkg-deb", "-f", deb, "Version"], capture_output=True, text=True).stdout.strip()
                script = os.path.join(C.run_dir(), "pairdesk-setup.sh")
                with open(script, "w") as f:
                    f.write(C.remote_setup_script(os.path.basename(deb), ver, C.hostname()))
                q = shlex.quote
                ctl = " ".join(q(o) for o in C.ssh_ctl_opts())
                st["ssh_login"] = login
                cmd = ("echo 'Copying PairDesk to %s ...'; scp %s %s %s %s:/tmp/ && ssh -t %s %s sh /tmp/pairdesk-setup.sh"
                       % (q(login), ctl, q(deb), q(script), q(login), ctl, q(login)))
                if self.open_terminal([cmd]):
                    sstat.set_markup("A terminal opened: follow it there. When it says it's finished, press "
                                     "<b>Try again</b>.")
                else:
                    sstat.set_markup("No terminal app was found. Run this in a terminal, then press <b>Try again</b>:"
                                     "\n<tt>%s</tt>" % esc(cmd))
                nxt.grab_focus()
            sgo.connect("clicked", ssh_setup)

            def show_ssh_row(*_):
                viassh.hide()
                grow.set_no_show_all(False)
                grow.show_all()
                glogin.grab_focus()

            def get_code(*_):
                login = glogin.get_text().strip()
                if not login:
                    return
                st["ssh_login"] = login
                gget.set_sensitive(False)
                gstat.set_text("Signing in to %s…" % login)

                def ok(code):
                    if not alive():
                        return False
                    gget.set_sensitive(True)
                    gstat.set_text("Signed in over SSH. Pairing…")
                    centry.set_visibility(False)          # it was never on screen: keep it that way
                    centry.set_text(code)
                    pair()
                    return False

                def bad(msg):
                    if not alive():
                        return False
                    gget.set_sensitive(True)
                    gstat.set_markup("<span foreground='#c01c28'>%s</span>" % esc(msg))
                    return False
                bg(lambda: C.ssh_get_code(login), ok, bad)
            viassh.connect("clicked", show_ssh_row)
            gget.connect("clicked", get_code)
            glogin.connect("activate", get_code)
            slogin.connect("activate", ssh_setup)

            def check(text):
                st["text"] = text
                show("busy", "Contacting %s…" % text)

                def got(r):
                    if not alive():
                        return False
                    stt = r.get("state")
                    host = esc(r.get("host", text))
                    port = r.get("port", C.LINK_PORT)
                    if stt == "pairdesk" or (stt == "ssh" and r.get("typed_user")):
                        start_pair(r)
                    elif stt == "ssh":
                        st["target"] = r
                        uh.set_markup("<span size='large' weight='bold'>What's your user name on %s?</span>" % host)
                        uerr.set_text("")
                        show("user")
                    elif stt == "unknown-host":
                        problem("No computer called %s was found" % r.get("host", text),
                                "Check the spelling, or type its IP address instead. It's shown on that computer: "
                                "PairDesk &gt; Current computer &gt; Address.")
                    elif "ssh" not in r:
                        # PairDesk doesn't answer: is a normal SSH server there? Then offer to set it up from here.
                        def ssh_known(s22):
                            r2 = dict(r)
                            r2["ssh"] = s22.get("state") == "ssh"
                            got(r2)
                            return False
                        bg(lambda: C.probe(r["host"], 22), ssh_known, lambda e: ssh_known({}))
                    elif r["ssh"]:
                        problem("PairDesk isn't answering at %s" % r["host"],
                                "Either PairDesk isn't installed there yet, or its remote access is off. If you're at "
                                "that computer: open PairDesk &gt; Current computer, turn on <b>Let paired computers "
                                "connect</b>, then press Try again here.", ssh_target=r)
                    else:
                        problem("Nothing answers at %s" % r.get("host", text),
                                "PairDesk couldn't reach that computer on port %d. Check, on that computer:\n\n"
                                "• PairDesk is installed and <b>Let paired computers connect</b> is on "
                                "(PairDesk &gt; Current computer).\n"
                                "• The address matches the one shown there.\n"
                                "• It's switched on and awake.\n"
                                "• A firewall isn't blocking it: there, run <tt>sudo ufw allow %d/tcp</tt>\n\n"
                                "PairDesk not installed there yet? Install it on that computer, or turn on its SSH "
                                "server (<tt>sudo apt install openssh-server</tt>) and PairDesk can set it up from "
                                "here." % (port, port))
                    return False
                bg(lambda: C.resolve_address(text), got, lambda e: (problem("That address doesn't work", esc(e)), False)[1])

            def start_pair(r):
                """Pair over SSH when that computer accepts SSH logins (its password proves it's you: no code,
                nothing to do at its screen); otherwise with a code shown on its screen."""
                st["target"] = r
                name = r.get("name") or r["host"]
                show("busy", "Checking how to pair with %s…" % name)

                def checked(ssh):
                    if not alive():
                        return False
                    if not ssh:
                        request(r)
                        return False
                    ch.set_markup("<span size='large' weight='bold'>Pair with %s over SSH</span>" % esc(name))
                    cs.set_markup("%s accepts SSH logins. Press <b>Pair over SSH</b> and sign in with its password: "
                                  "PairDesk pairs by itself. No code, nothing to do at its screen." % esc(name))
                    for w in (hbox, centry, cerr, viassh):
                        w.hide()
                    newcode.set_label("Use a pairing code instead")
                    newcode.show()
                    safe.set_markup(SAFE_SSH)
                    glogin.set_text(st.get("ssh_login") or "%s@%s" % (r.get("user") or C.getpass_user(), r["host"]))
                    gstat.set_text("")
                    pc.reorder_child(grow, 2)
                    pc.reorder_child(gstat, 3)
                    gget.get_style_context().add_class("suggested-action")
                    show("code")
                    show_ssh_row()
                    gget.grab_focus()
                    return False
                bg(lambda: C.probe(r["host"], 22).get("state") == "ssh", checked, lambda _e: checked(False))

            def request(r):
                st["target"] = r
                name = r.get("name") or r["host"]
                show("busy", "Asking %s to show a pairing code…" % name)

                def ok(res):
                    if not alive():
                        return False
                    rname, headless = res
                    r["name"] = rname
                    st["headless"] = headless
                    centry.set_text("")
                    cerr.set_text("")
                    centry.show()
                    cerr.show()
                    newcode.set_label("Show the code again")
                    safe.set_markup(SAFE_CODE)
                    if headless:
                        ch.set_markup("<span size='large' weight='bold'>Pair with %s over SSH</span>" % esc(rname))
                        cs.set_markup("%s has no screen to show a code on. Press <b>Pair over SSH</b>: PairDesk signs "
                                      "in with that computer's password and pairs by itself, with no code to type. "
                                      "Or run this in a terminal and type the code it shows:" % esc(rname))
                        hcmd.set_markup("<tt>ssh %s@%s pairdesk pairing</tt>" % (esc(r["user"]), esc(r["host"])))
                        hbox.set_no_show_all(False)
                        hbox.show_all()
                    else:
                        ch.set_markup("<span size='large' weight='bold'>Type the code shown on %s</span>" % esc(rname))
                        cs.set_markup("A pairing code just appeared on the screen of <b>%s</b>. Type it here." % esc(rname))
                        hbox.hide()
                    glogin.set_text(st.get("ssh_login") or "%s@%s" % (r["user"], r["host"]))
                    gstat.set_text("")
                    if headless:      # the SSH way first: it's the main route without a screen
                        pc.reorder_child(grow, 2)
                        pc.reorder_child(gstat, 3)
                        gget.get_style_context().add_class("suggested-action")
                        show_ssh_row()
                    else:
                        pc.reorder_child(grow, -1)
                        pc.reorder_child(gstat, -1)
                        gget.get_style_context().remove_class("suggested-action")
                        grow.hide()
                        viassh.show()
                    show("code")
                    if headless:
                        gget.grab_focus()
                    return False

                def bad(msg):
                    if not alive():
                        return False
                    if "doesn't accept pairing right now" in msg:      # only after "Pair a new computer" there
                        ok((name, True))
                        cs.set_markup("%s accepts pairing only after <b>Pair a new computer</b> is pressed there. "
                                      "If you can sign in to it with SSH, press <b>Pair over SSH</b>: PairDesk signs "
                                      "in with that computer's password and pairs by itself, with no code to type."
                                      % esc(name))
                        hbox.hide()
                        return False
                    if "wrong user name" in msg or "user name in the address" in msg:
                        uh.set_markup("<span size='large' weight='bold'>What's your user name on %s?</span>" % esc(name))
                        uerr.set_markup("<span foreground='#c01c28'>%s didn't accept <b>%s</b>. Check the user "
                                        "name.</span>" % (esc(name), esc(r.get("user", ""))))
                        show("user")
                    elif "not accepting" in msg or "remote access is off" in msg:
                        problem("Remote access is off on %s" % name,
                                "On that computer open PairDesk &gt; Current computer and turn on <b>Let paired "
                                "computers connect</b>. Then press Try again.")
                    else:
                        problem("%s didn't show a code" % name, esc(msg))
                    return False
                addr = r.get("address") or "%s@%s:%d" % (r.get("user"), r["host"], r["port"])
                bg(lambda: C.client_request_pairing(addr, log=lambda m: None), ok, bad)

            def pair():
                r = st["target"]
                addr = r.get("address")
                code = centry.get_text().strip()
                show("busy", "Pairing with %s…" % r.get("name", r["host"]))

                def ok(name):
                    if not alive():
                        return False
                    self.cfg = C.load_config()
                    self.refresh_peers(select=name)
                    self.log("Paired with %s." % name)
                    dh.set_markup("<span size='large' weight='bold'>✔ Paired with %s</span>" % esc(name))
                    ds.set_markup("You can connect to <b>%s</b> now. What you share (sound, folders, USB devices) "
                                  "is under <b>Options</b> on the Connect tab." % esc(name))
                    st["paired"] = name
                    show("done")
                    return False

                def bad(msg):
                    if not alive():
                        return False
                    show("code")
                    cerr.set_markup("<span foreground='#c01c28'>%s</span>" % esc(msg))
                    centry.grab_focus()
                    centry.select_region(0, -1)
                    return False
                bg(lambda: C.client_pair_code(addr, code, log=lambda m: None, host_name=st["target"].get("host_name")),
                   ok, bad)

            def go_next():
                if not nxt.get_sensitive() or not nxt.get_visible():
                    return
                p_ = st["page"]
                if p_ == "find":
                    row = lb.get_selected_row()
                    text = entry.get_text().strip()
                    if text:
                        check(text)
                    elif row is not None:
                        start_pair(dict(row.target))
                elif p_ == "problem":
                    check(st.get("text", ""))
                elif p_ == "user":
                    r = dict(st["target"])
                    r["user"] = uentry.get_text().strip()
                    r["address"] = "%s@%s:%d" % (r["user"], r["host"], r["port"])
                    start_pair(r)
                elif p_ == "code":
                    pair()
                elif p_ == "done":
                    name = st.get("paired")
                    close()
                    self.stack.set_visible_child_name("connect")
                    self.refresh_peers(select=name)
                    if not self.session:
                        self.on_connect()

            def go_back():
                p_ = st["page"]
                if p_ == "code" and st["target"] and st["target"].get("state") == "ssh":
                    show("user")
                else:
                    show("find")

            def close():
                st["closed"] = True
                d.destroy()

            def on_response(_d, resp):
                if resp == NEXT:
                    go_next()
                elif resp == BACK:
                    go_back()
                else:
                    close()
            d.connect("response", on_response)
            newcode.connect("clicked", lambda *_: request(st["target"]))
            hcopy.connect("clicked", lambda b: copy(
                "ssh %s@%s pairdesk pairing" % (st["target"]["user"], st["target"]["host"]), b))
            d.show_all()
            hbox.hide()
            show("find")
            scan()

        def pair_new(self, code=None, requester=None):
            """Server side: show the one-time code (new, or one a remote computer asked for)."""
            if self._pair_dialog_open:
                return
            try:
                code = code or C.start_pairing()
            except C.DBError as e:
                self.error(str(e))
                return
            self._pair_dialog_open = True
            before = dict(C.load_config()["incoming"])
            d = Gtk.Dialog(title="Pair a new computer", transient_for=self, modal=True)
            d.add_button("Cancel", 0)
            box = d.get_content_area()
            box.set_spacing(10)
            for m in ("set_margin_start", "set_margin_end", "set_margin_top", "set_margin_bottom"):
                getattr(box, m)(16)
            if requester:
                rq = Gtk.Label(xalign=0, wrap=True, max_width_chars=56)
                rq.set_markup("<b>%s</b> wants to pair with the current computer. If that's you, type this code "
                              "there. If not, press Cancel." % GLib.markup_escape_text(requester))
                box.add(rq)
                self.present()
            else:
                box.add(Gtk.Label(label="On the other computer: PairDesk > + (Add remote computer), choose this computer "
                                        "or type its address, press Next, then type the code:",
                                  xalign=0, wrap=True, max_width_chars=56))
            g = Gtk.Grid(column_spacing=12, row_spacing=6)
            g.attach(Gtk.Label(label="Address", xalign=1), 0, 0, 1, 1)
            addrs = my_addresses() or ["<this computer's IP address>"]
            al = Gtk.Label(label="\n".join(addrs), xalign=0, selectable=True)
            al.set_markup("<b>%s</b>" % GLib.markup_escape_text("\n".join(addrs)))
            g.attach(al, 1, 0, 1, 1)
            g.attach(Gtk.Label(label="Pairing code", xalign=1), 0, 1, 1, 1)
            g.attach(code_view(code), 1, 1, 1, 1)
            box.add(g)
            if len(addrs) > 1:
                box.add(Gtk.Label(label="Use the address on the same network as the other computer.",
                                  xalign=0, wrap=True))
            left = Gtk.Label(xalign=0)
            left.get_style_context().add_class("db-muted")
            box.add(left)
            d.show_all()
            state = {"done": False}

            def tick():
                c = C.load_config()
                new = [n for n, v in c["incoming"].items() if before.get(n) != v]  # new, or paired again
                if new:
                    state["done"] = True
                    d.response(1)
                    return False
                pr = c.get("pairing")
                if not pr:
                    d.response(0)
                    return False
                secs = int(pr["expires"] - time.time())
                if secs <= 0:
                    d.response(0)
                    return False
                left.set_text("Waiting for the other computer… code works for %d:%02d more" % (secs // 60, secs % 60))
                return True
            tick()
            GLib.timeout_add(1000, tick)
            d.run()
            d.destroy()
            self._pair_dialog_open = False
            if state["done"]:
                self.cfg = C.load_config()
                self.refresh_paired()
                self.notice("Paired", "%s can now connect to the current computer."
                            % ", ".join(sorted(set(self.cfg["incoming"]) - before)))
            else:
                C.stop_pairing()
                self.log("Pairing closed.")

        def change_port(self):
            d = Gtk.Dialog(title="PairDesk port", transient_for=self, modal=True)
            d.add_buttons("Cancel", 0, "Save", 1)
            pri(d, 1)
            box = d.get_content_area()
            for m in ("set_margin_start", "set_margin_end", "set_margin_top", "set_margin_bottom"):
                getattr(box, m)(14)
            box.set_spacing(8)
            box.add(Gtk.Label(label="Port remote computers use to reach the current computer (1024-65535). "
                                    "Paired computers need to pair again after a change.",
                              xalign=0, wrap=True, max_width_chars=50))
            sp = Gtk.SpinButton.new_with_range(1024, 65535, 1)
            sp.set_value(C.link_port())
            sp.set_activates_default(True)
            box.add(sp)
            d.show_all()
            ok = d.run() == 1
            port = int(sp.get_value())
            d.destroy()
            if not ok or port == C.link_port():
                return
            if port in (3389, 3240) or 47300 <= port < 47700:
                self.error("Port %d is used by PairDesk itself; choose another." % port)
                return
            self.cfg = C.load_config()
            self.cfg["link_port"] = port
            self.save()
            if self.accepting():
                bg(C.link_start, lambda _r: (self.refresh_status(), self.log("PairDesk now uses port %d." % port)))
            else:
                self.refresh_status()

        def ask_password(self, n, p):
            if KR["Secret"]:
                try:
                    pw = KR["Secret"].password_lookup_sync(KR["SCHEMA"], {"peer": n}, None)
                    if pw:
                        return p.get("rdp_user", p["user"]), pw, True
                except GLib.Error:
                    pass
            d = Gtk.Dialog(title="Desktop login", transient_for=self, modal=True)
            d.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Connect", Gtk.ResponseType.OK)
            pri(d, Gtk.ResponseType.OK)
            g = Gtk.Grid(column_spacing=8, row_spacing=8, margin=12)
            u = Gtk.Entry(text=p.get("rdp_user", p["user"]))
            pw = Gtk.Entry(visibility=False, activates_default=True)
            rem = Gtk.CheckButton(label="Remember password" if KR["Secret"] else
                                  "Remember password (asks to add password storage first)")
            hint = {"gnome": "Type the Remote Login user name and password that were chosen on %s "
                             "(its Settings > System > Remote Desktop > Remote Login)." % n,
                    "xrdp": "Type your normal login user name and password for %s." % n}.get(
                p.get("rdp_backend"),
                "If %s uses GNOME Remote Login, type the user name and password chosen there "
                "(its Settings > System > Remote Desktop). Otherwise use your normal login for %s." % (n, n))
            hl = Gtk.Label(label=hint, xalign=0, wrap=True, max_width_chars=50)
            hl.get_style_context().add_class("dim-label")
            g.attach(Gtk.Label(label="Desktop login on %s" % n, xalign=0), 0, 0, 2, 1)
            g.attach(hl, 0, 4, 2, 1)
            g.attach(Gtk.Label(label="User", xalign=1), 0, 1, 1, 1)
            g.attach(u, 1, 1, 1, 1)
            g.attach(Gtk.Label(label="Password", xalign=1), 0, 2, 1, 1)
            g.attach(pw, 1, 2, 1, 1)
            g.attach(rem, 1, 3, 1, 1)
            d.get_content_area().add(g)
            d.show_all()
            pw.grab_focus()
            r = d.run()
            res = (u.get_text().strip(), pw.get_text(), rem.get_active())
            d.destroy()
            if r != Gtk.ResponseType.OK:
                return None
            p["rdp_user"] = res[0]
            self.save()
            if res[2]:
                def store():
                    if load_keyring():
                        KR["Secret"].password_store_sync(KR["SCHEMA"], {"peer": n}, KR["Secret"].COLLECTION_DEFAULT,
                                                         "PairDesk desktop login for %s" % n, res[1], None)
                self.ensure("keyring", store, context="You ticked \"Remember password\".")
            return res

        def disconnect_session(self):
            s = self.session
            if not s:
                return
            self.conn_btn.set_sensitive(False)
            self.status.set_text("Disconnecting from %s…" % s.name)
            bg(s.disconnect, lambda _r: self.end_session(), lambda _e: self.end_session())

        def open_desktop_window(self, s):
            """Called while connecting: the window the desktop is shown in. Returns (xid, width, height)."""
            d = getattr(self, "desk", None)
            if d is not None and d.s is s:          # the view is opened again (sound changes): same window
                d.ready = False
                d._seen = d._fit_tries = 0
                return d.target()
            self.close_desktop_window()
            self.desk = DesktopWindow(self, s)
            if s.opts.get("fullscreen"):
                self.desk.fullscreen()
            while Gtk.events_pending():
                Gtk.main_iteration()
            return self.desk.target()

        def close_desktop_window(self):
            d = getattr(self, "desk", None)
            self.desk = None
            if d is not None:
                d.close_window()

        def on_connect(self):
            if self.session:
                s = self.session
                self.conn_btn.set_sensitive(False)
                bg(s.disconnect, lambda _r: self.end_session())
                return
            n, p = self.peer()
            if not p:
                return
            opts = dict(p.get("opts", C.DEFAULT_OPTS))
            need = []
            if opts.get("desktop"):
                need.append(("viewer", "To show the desktop of %s, the current computer needs a viewer." % n,
                             lambda: opts.update(desktop=False)))
            if opts.get("open_theirs"):
                need.append(("folders", "To open the shared folder of %s on the current computer." % n,
                             lambda: opts.update(open_theirs=False)))
            if opts.get("share_mine"):
                need.append(("share-out", "To share the current folder with %s." % n,
                             lambda: opts.update(share_mine=False)))
            self.ensure_all(need, lambda: self._connect(n, p, opts))

        def _connect(self, n, p, opts):
            pw = None
            if opts.get("desktop"):
                got = self.ask_password(n, p)
                if not got:
                    return
                pw = got[1]
            try:
                s = C.Session(n, log=self.log, on_state=lambda st: GLib.idle_add(self.session_state, st))
                s.on_conflict = self.ask_sign_out
                s.on_update = self.before_login
                if self.cfg.get("desktop_in_window", True) and "X11" in type(self.get_display()).__name__:
                    s.embed_host = lambda: self.in_main(lambda: self.open_desktop_window(s))
            except C.DBError as e:
                self.error(str(e))
                return
            self.session = s
            self.conn_btn.set_label("Connecting…")
            self.conn_btn.set_sensitive(False)

            def desktop_closed(rc, err):
                def ui():
                    if self.session is not s:
                        return
                    lines = [l for l in err.splitlines() if "ERROR" in l or "error" in l]
                    if rc not in (0, 12, 11, 1) or (rc and lines):
                        self.log("Desktop closed: %s" % (lines[-1][-160:] if lines else "code %d" % rc))
                        if "TLS_CONNECT_FAILED" in err and s.opts.get("direct_desktop"):
                            self.error("The desktop certificate of %s didn't match what PairDesk checked over "
                                       "the secure link, so the direct connection was refused. Turn off "
                                       "\"Direct desktop stream\" to use the link." % n)
                        elif any(w in err for w in ("AUTHENTICATION", "LOGON_FAILURE", "authentication")):
                            if KR["Secret"]:
                                KR["Secret"].password_clear_sync(KR["SCHEMA"], {"peer": n}, None)
                            self.error("The desktop login on %s failed. Check the user name and password." % n)
                    self.conn_btn.set_sensitive(False)
                    bg(s.disconnect, lambda _r: self.end_session())
                GLib.idle_add(ui)

            def started(info):        # link is up; desktop is opening; USB/folders follow
                self.conn_btn.set_label("Disconnect")
                self.conn_btn.get_style_context().remove_class("suggested-action")
                self.conn_btn.get_style_context().add_class("destructive-action")
                self.conn_btn.set_sensitive(True)
                self.status.set_text("Connected to %s" % n)

            def finished(_info):       # USB devices and folders are in place
                if opts.get("desktop") and s.signout_refused:
                    self.notice("Sign-out refused on %s" % n,
                                "Someone at the screen of %s pressed Cancel, so the session there stays signed "
                                "in and its desktop can't be opened from here (the same user can't have two "
                                "desktops).\n\nFolders and USB devices are connected. Connect again when the "
                                "screen there is free." % n)
                elif opts.get("desktop") and s.info.get("rdp_warning"):
                    self.notice("Desktop of %s not opened" % n, s.info["rdp_warning"] +
                                "\n\nFolders and USB devices are connected.")
                self.refresh_local(force=True)
                self.refresh_remote()
                self.folder_btn.set_sensitive(bool(s.mounted_theirs))
                self.folder_btn.set_visible(bool(s.mounted_theirs))

            def failed(msg):
                bg(s.disconnect, lambda _r: None, lambda _e: None)
                self.end_session()
                if "removed its pairing" in msg:
                    self.cfg = C.load_config()
                    self.refresh_peers()
                    self.refresh_paired()
                self.error(msg)
            bg(lambda: s.connect(opts, pw, desktop_closed, on_ready=lambda i: GLib.idle_add(started, i)),
               finished, failed)

        def session_state(self, st):
            s = self.session
            if not s:
                return
            if st == "closed" and s.taken_over:
                GLib.idle_add(lambda: (self.end_session(), self.notice(
                    "Connected from another window", "Another PairDesk window connected to %s, so this one "
                    "disconnected. Only one connection to the same computer works at a time." % s.name), False)[-1])
                return
            if st == "reconnecting":
                self.status.set_text("Connection lost. Reconnecting to %s…" % s.name)
                self.folder_btn.set_sensitive(False)
            elif st == "connected" and self.conn_btn.get_label() == "Disconnect":
                self.status.set_text("Connected to %s" % s.name)
                self.folder_btn.set_sensitive(bool(s.mounted_theirs))
                self.refresh_local(force=True)
                self.refresh_remote()

        def set_camera(self, cam, on):
            """Send a camera of this computer as video (it shows up there as "PairDesk camera"), or stop."""
            s = self.session
            if not s:
                return
            if not on:
                bg(s.stop_camera)
                return

            def start():
                if not (s.info.get("features") or {}).get("camera-receive"):
                    self.remote_install(s, ["camera-receive"], go, why="To show a camera sent from here, %s "
                                        "needs a virtual camera." % s.name)
                    return
                go()

            def go():
                self.status.set_text("Starting %s…" % cam["name"])
                bg(lambda: s.send_camera(cam), lambda _r: self.status.set_text("%s is a camera on %s now."
                                                                              % (cam["name"], s.name)),
                   lambda m: self.error(m.replace("NEEDS-REMOTE:camera-receive",
                                                  "%s still needs the virtual camera." % s.name)))
            self.ensure("camera-send", start, context="To send %s to %s as video." % (cam["name"], s.name))

        def camera_from_usb(self, dev):
            """A camera lent to the remote computer as a USB device: take it back, then send it as video."""
            s = self.session
            if not s:
                return
            before = {c["dev"] for c in C.list_cameras()}
            n, p = s.name, self.cfg["peers"].get(s.name, {})
            if dev["key"] in p.get("usb_send", []):
                p["usb_send"].remove(dev["key"])
                self.save()
            self.status.set_text("Taking %s back from %s…" % (dev["name"], n))

            def back():
                if dev["busid"] in s.sent:
                    s.recall_usb(dev["busid"])
                else:                      # still lent from an earlier connection
                    C.helper("usb-unbind", dev["busid"])
                for _ in range(40):        # wait for its camera to appear here again
                    new = [c for c in C.list_cameras() if c["dev"] not in before] or C.list_cameras()
                    if new:
                        return new[0]
                    time.sleep(0.25)
                raise C.DBError("%s came back, but no camera appeared for it on this computer." % dev["name"])
            bg(back, lambda cam: (self.refresh_local(force=True), self.set_camera(cam, True)))

        def change_sound(self, s, kw):
            """Sound or microphone choice changed in the desktop toolbar: remember it for this computer and
            reopen the desktop view with it."""
            p = self.cfg["peers"].get(s.name)
            if p is not None:
                p.setdefault("opts", dict(C.DEFAULT_OPTS)).update(kw)
                self.save()
                self.on_peer_changed()
            self.status.set_text("Applying the sound settings…")
            bg(lambda: s.reopen_desktop(kw), lambda ok: self.status.set_text(
                "Sound settings applied." if ok else "Saved; used the next time you connect."))

        def remote_install(self, s, need, then, why=None):
            """Install add-ons on the remote computer over SSH, in a terminal, from the main thread; then()
            runs afterwards if they're there."""
            n = s.name
            names = "\n".join("• " + C.FEATURES[x]["title"] for x in need)
            d = Gtk.MessageDialog(transient_for=getattr(self, "desk", None) or self, modal=True,
                                  message_type=Gtk.MessageType.QUESTION, text="Install on %s?" % n)
            d.format_secondary_text("%s%s needs:\n%s\n\nA terminal opens and asks for %s's password, then its "
                                    "admin password." % ((why + "\n\n") if why else "", n, names, n))
            d.add_button("Cancel", 0)
            d.add_button("Install over SSH", 1)
            pri(d, 1)
            r = d.run()
            d.destroy()
            if r != 1:
                return
            login = "%s@%s" % (s.p["user"], s.p["host"])
            cmd = "ssh -t %s %s" % (shlex.quote(login), shlex.quote(C.remote_install_command(need)))
            opened = self.open_terminal([cmd])
            d = Gtk.MessageDialog(transient_for=getattr(self, "desk", None) or self, modal=True,
                                  message_type=Gtk.MessageType.INFO, text="Installing on %s" % n)
            d.format_secondary_markup("Follow the terminal. When it's finished, press <b>Continue</b>." if opened
                                      else "No terminal app was found. Run this in a terminal, then press "
                                      "<b>Continue</b>:\n\n<tt>%s</tt>" % GLib.markup_escape_text(cmd))
            d.add_button("Cancel", 0)
            d.add_button("Continue", 1)
            pri(d, 1)
            r = d.run()
            d.destroy()
            if r != 1:
                return

            def check(info):
                s.info = info
                left = [x for x in need if x != "usb" and not (info.get("features") or {}).get(x)]
                if "usb" in need and not info.get("usb_ready"):
                    left.append("usb")
                if left:
                    self.error("%s still doesn't have: %s. The terminal shows why."
                               % (n, ", ".join(C.FEATURES[x]["title"] for x in left)))
                else:
                    self.refresh_remote()
                    then()
            bg(lambda: s.call("info"), check)

        def in_main(self, fn):
            """Run fn() (which shows a dialog) on the main thread and wait for its result."""
            ev, res = threading.Event(), [None]

            def go():
                try:
                    res[0] = fn()
                finally:
                    ev.set()
                return False
            GLib.idle_add(go)
            ev.wait()
            return res[0]

        def choose(self, title, text, buttons, kind=Gtk.MessageType.QUESTION, markup=False):
            """A dialog with buttons [(label, response)]; the last one is the main one. Returns the response."""
            def show():
                d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=kind, text=title)
                (d.format_secondary_markup if markup else d.format_secondary_text)(text)
                for label, r in buttons:
                    d.add_button(label, r)
                pri(d, buttons[-1][1])
                r = d.run()
                d.destroy()
                return r
            return self.in_main(show)

        def before_login(self, s, info):
            """While connecting, before the desktop opens: update the older PairDesk, then add what the other
            computer is missing for the chosen options. Returns True when the other computer was changed."""
            changed = self.update_before_login(s, info)
            if changed:
                for _ in range(15):
                    try:
                        info = s.call("info") if s.alive() else s.open()
                        break
                    except C.DBError:
                        time.sleep(2)
            need = C.remote_needs(info, s.opts, s.p)
            n = s.name
            if not need or self.cfg.get("needs_skip", {}).get(n) == ",".join(need):
                return changed
            login = "%s@%s" % (s.p["user"], s.p["host"])
            cmd = "ssh -t %s %s" % (shlex.quote(login), shlex.quote(C.remote_install_command(need)))
            names = "\n".join("• " + C.FEATURES[x]["title"] for x in need)
            r = self.choose("%s needs add-ons for your options" % n,
                            "For what you chose under Options, %s needs:\n%s\n\nInstall them now over SSH? A "
                            "terminal opens and asks for %s's password, then its admin password."
                            % (n, names, n), [("Skip and connect", 0), ("Install over SSH", 1)])
            if r != 1:
                def remember():
                    self.cfg.setdefault("needs_skip", {})[n] = ",".join(need)
                    self.save()
                GLib.idle_add(remember)
                self.log("Skipped on %s: %s. PairDesk asks again if your options change; or turn those options "
                         "off." % (n, ", ".join(C.FEATURES[x]["title"] for x in need)))
                return changed
            opened = self.in_main(lambda: self.open_terminal([cmd]))
            esc = GLib.markup_escape_text
            r = self.choose("Installing on %s" % n,
                            "Follow the terminal. When it's finished, press <b>Continue</b>." if opened else
                            "No terminal app was found. Run this in a terminal, then press <b>Continue</b>:"
                            "\n\n<tt>%s</tt>" % esc(cmd), [("Skip", 0), ("Continue", 1)], markup=True)
            if r != 1:
                return changed
            try:
                left = C.remote_needs(s.call("info"), s.opts, s.p)
            except C.DBError:
                left = []
            if left:
                self.choose("Not installed on %s" % n,
                            "%s still doesn't have: %s. The terminal shows why. Connecting without it."
                            % (n, ", ".join(C.FEATURES[x]["title"] for x in left)), [("Connect", 0)],
                            kind=Gtk.MessageType.WARNING)
            return True

        def update_before_login(self, s, info):
            """Called while connecting, before the desktop opens: if one computer has a newer PairDesk, update
            the other one first, or skip. Returns True when the remote computer was updated."""
            n, mine = s.name, C.my_version()
            theirs = info.get("package") or info.get("version")
            way = C.update_direction(mine, theirs)
            key = "%s:%s:%s" % (way, mine, theirs)
            if not way or self.cfg.get("update_skip", {}).get(n) == key:
                return False
            if way == "pull":
                text = ("%s has PairDesk %s; this computer has %s. Update this computer first? PairDesk copies "
                        "the newer version from %s and asks for your admin password. Then it connects."
                        % (n, theirs, mine, n))
            else:
                text = ("%s has PairDesk %s; this computer has %s. Update %s first? PairDesk sends it your "
                        "version; an administrator of %s confirms with its password. Then it connects."
                        % (n, theirs, mine, n, n))
            r = self.choose("%s has %s PairDesk" % (n, "a newer" if way == "pull" else "an older"), text,
                            [("Skip and connect", 0), ("Update first", 1)])
            if r != 1:
                def remember():
                    self.cfg.setdefault("update_skip", {})[n] = key
                    self.save()
                GLib.idle_add(remember)
                self.log("Update skipped. PairDesk asks again when either computer gets another version.")
                return False
            try:
                if way == "pull":
                    self.log("Copying PairDesk %s from %s…" % (theirs, n))
                    path, ver = s.fetch_package()
                    self.log("Installing PairDesk %s (asks for your admin password)…" % ver)
                    C.install_update(path)
                    self.log("PairDesk %s is installed here. It's used from the next time PairDesk starts." % ver)
                    return False
                self.log("Sending PairDesk %s to %s…" % (mine, n))
                rep = s.push_package(C.package_for_peer())
            except C.DBError as e:
                self.choose("Update not done", "%s\n\nConnecting without updating." % e, [("Connect", 0)],
                            kind=Gtk.MessageType.WARNING)
                return False
            login = "%s@%s" % (s.p["user"], s.p["host"])
            cmd = "ssh -t %s pairdesk update --install" % shlex.quote(login)
            there = rep.get("state") == "offered"
            r = self.choose("Install the update on %s" % n,
                            "PairDesk %s is on %s. Install it now over SSH, before signing in: a terminal opens "
                            "and asks for %s's password, then its admin password for sudo.%s"
                            % (rep.get("version", mine), n, n,
                               "\n\nOr approve it in the window it shows on its screen, after signing in."
                               if there else ""),
                            [("Approve it there later" if there else "Skip and connect", 0),
                             ("Install now over SSH", 1)])
            if r != 1:
                self.log("The update waits on %s: %s" % (n, cmd))
                return False
            opened = self.in_main(lambda: self.open_terminal([cmd]))
            esc = GLib.markup_escape_text
            r = self.choose("Install the update on %s" % n,
                            ("Follow the terminal. When it says PairDesk %s is installed, press <b>Continue</b>."
                             % esc(rep.get("version", mine))) if opened else
                            ("No terminal app was found. Run this in a terminal, then press <b>Continue</b>:"
                             "\n\n<tt>%s</tt>" % esc(cmd)),
                            [("Skip", 0), ("Continue", 1)], markup=True)
            return r == 1

        def ask_sign_out(self, name):
            """Called from the connecting thread: may we sign out the local session on the remote computer?"""
            ev, ans = threading.Event(), [False]

            def ask():
                d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                      text="Someone is signed in on %s's screen" % name)
                d.format_secondary_text(
                    "Its desktop server can't open a second desktop for the same user. PairDesk can sign that "
                    "session out: %s's screen shows a 30-second notice first, and anyone there can cancel. "
                    "Unsaved work in that session would be lost." % name)
                d.add_button("Don't sign out", 0)
                d.add_button("Sign out and connect", 1)
                pri(d, 1, danger=True, default=0)
                ans[0] = d.run() == 1
                d.destroy()
                ev.set()
            GLib.idle_add(ask)
            ev.wait()
            return ans[0]

        def end_session(self):
            self.close_desktop_window()
            self.session = None
            self.remote_devs = []
            self.conn_btn.set_label("Connect")
            self.conn_btn.get_style_context().remove_class("destructive-action")
            self.conn_btn.get_style_context().add_class("suggested-action")
            self.conn_btn.set_sensitive(True)
            self.status.set_text("Not connected")
            self.folder_btn.set_sensitive(False)
            self.folder_btn.hide()
            self.on_peer_changed()

        def on_close(self, *_):
            if self.session:
                # keep the session: minimize; it ends with Disconnect or when the desktop window closes
                if not self.cfg.get("told_minimize"):
                    self.cfg["told_minimize"] = True
                    self.save()
                    self.notice("Still connected to %s" % self.session.name,
                                "PairDesk keeps the connection while its window is minimized. To end it, "
                                "close the remote desktop window or press Disconnect.")
                self.iconify()
                return True
            Gtk.main_quit()
            return False

        # --------------------------------------------------------- This computer page
        def build_server(self):
            page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)

            # remote access: switch + address + pair
            ra = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            top = Gtk.Box(spacing=12)
            lab = Gtk.Label(label="Let paired computers connect to the current computer", xalign=0, wrap=True)
            top.pack_start(lab, True, True, 0)
            self.accept_sw = Gtk.Switch(active=self.accepting(), valign=Gtk.Align.CENTER)
            self.accept_sw.connect("notify::active", self.on_accept)
            top.pack_end(self.accept_sw, False, False, 0)
            ra.pack_start(top, False, False, 0)
            expl = Gtk.Label(xalign=0, wrap=True)
            expl.set_markup("<small>Off: no port is open. On: keeps working when this window is closed.</small>")
            expl.get_style_context().add_class("db-muted")
            ra.pack_start(expl, False, False, 0)
            row = Gtk.Box(spacing=8)
            self.link_lbl = Gtk.Label(xalign=0, wrap=True, selectable=True)
            row.pack_start(self.link_lbl, True, True, 0)
            self.pair_btn = Gtk.Button(label="Pair a new computer…")
            self.pair_btn.get_style_context().add_class("suggested-action")
            self.pair_btn.connect("clicked", lambda *_: self.pair_new())
            row.pack_end(self.pair_btn, False, False, 0)
            ra.pack_start(row, False, False, 0)
            page.pack_start(self.frame("Remote access", ra), False, False, 0)

            # paired computers, both directions, with Unpair
            self.paired_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
            self.paired_list.get_style_context().add_class("db-plain")
            page.pack_start(self.frame("Paired computers", self.paired_list), False, False, 0)

            # status: only what matters, with a button when something is missing
            g = Gtk.Grid(column_spacing=12, row_spacing=6)
            self.st_labels = {}
            rows = [("ssh", "Link"), ("rdp", "Desktop sharing"), ("usb", "USB sharing")]
            for i, (k, lbl) in enumerate(rows):
                t = Gtk.Label(label=lbl, xalign=0)
                t.get_style_context().add_class("db-muted")
                g.attach(t, 0, i, 1, 1)
                l = Gtk.Label(label="…", xalign=0, selectable=True, wrap=True, max_width_chars=40, hexpand=True)
                g.attach(l, 1, i, 1, 1)
                self.st_labels[k] = l
            self.fix_btns = {}
            for row_i, key, label, fn in (
                    (0, "ssh", "Install…", lambda: self.ensure(
                        "accept", lambda: (self.on_mode(None, self.cfg["mode"]), self.refresh_status()),
                        context="Remote access lets paired computers connect to the current computer.")),
                    (1, "rdp", "Set up…", lambda: self.fix_desktop()),
                    (2, "usb", "Set up…", lambda: self.do_setup())):
                b = Gtk.Button(label=label, halign=Gtk.Align.END)
                b.connect("clicked", lambda _b, f=fn: f())
                b.set_no_show_all(True)
                g.attach(b, 2, row_i, 1, 1)
                self.fix_btns[key] = b
            page.pack_start(self.frame("Status", g), False, False, 0)
            self.refresh_status()
            return page

        def show_help(self, topic="start"):
            w = Gtk.Window(title="PairDesk Help", transient_for=self)
            w.set_default_size(min(820, self.get_allocated_width()), min(560, self.get_allocated_height()))
            stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
            for tid, title, text in HELP_TOPICS:
                lab = Gtk.Label(xalign=0, yalign=0, wrap=True, max_width_chars=64, selectable=True,
                                margin=18)
                lab.set_markup("<span size='large' weight='bold'>%s</span>\n\n%s" % (title, text))
                page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
                page.pack_start(lab, False, False, 0)
                if tid == "headless":
                    b = Gtk.Button(label="Set up a computer without a monitor…", halign=Gtk.Align.START,
                                   margin_start=18)
                    b.connect("clicked", lambda *_: self.headless_help())
                    page.pack_start(b, False, False, 0)
                if tid == "network":
                    b = Gtk.Button(label="Open log file", halign=Gtk.Align.START, margin_start=18)
                    b.connect("clicked", lambda *_: self.open_path(C.log_file()))
                    page.pack_start(b, False, False, 0)
                stack.add_titled(self.scrolled(page), tid, title)
            side = Gtk.StackSidebar(stack=stack)
            side.set_size_request(220, -1)
            box = Gtk.Box()
            box.pack_start(side, False, False, 0)
            box.pack_start(stack, True, True, 0)
            w.add(box)
            w.show_all()
            stack.set_visible_child_name(topic)

        def about(self):
            d = Gtk.AboutDialog(transient_for=self, modal=True, program_name="PairDesk", version=C.VERSION,
                                logo_icon_name="pairdesk", license_type=Gtk.License.MIT_X11,
                                comments="Remote desktop with USB devices, folders, clipboard and sound, both "
                                         "ways, over PairDesk's own encrypted link.\n\nA KnowReva project.",
                                website=C.HOMEPAGE, website_label=C.HOMEPAGE.split("//")[1],
                                copyright="© 2026 KnowReva")
            d.run()
            d.destroy()

        def open_terminal(self, cmd):
            """Open the desktop's terminal app running cmd (a list). Returns False if there's none."""
            for term, pre in (("x-terminal-emulator", ["-e"]), ("gnome-terminal", ["--"]), ("kgx", ["--"]),
                              ("ptyxis", ["--"]), ("konsole", ["-e"]), ("xfce4-terminal", ["-x"]),
                              ("mate-terminal", ["-x"]), ("lxterminal", ["-e"]), ("tilix", ["-e"]),
                              ("xterm", ["-e"])):
                if shutil.which(term):
                    hold = cmd + ["; echo; read -p 'Press Enter to close this window ' x"]
                    subprocess.Popen([term] + pre + ["sh", "-c", " ".join(hold)], start_new_session=True,
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    return True
            return False

        def headless_help(self):
            n, p = self.peer()
            d = Gtk.Dialog(title="Set up a computer without a monitor", transient_for=self, modal=True)
            d.set_default_size(620, -1)
            d.add_button("Close", 0)
            box = d.get_content_area()
            box.set_spacing(10)
            for m in ("set_margin_start", "set_margin_end", "set_margin_top", "set_margin_bottom"):
                getattr(box, m)(16)
            intro = Gtk.Label(xalign=0, wrap=True, max_width_chars=70)
            intro.set_markup(
                "Set up the other computer from here over SSH, using its normal SSH login. PairDesk must be "
                "installed on it. Each step is checked first and you're asked before anything changes:\n"
                "remote access on, keep running with nobody signed in, desktop server (xrdp) that needs no "
                "monitor, automatic sign-in off, no sleeping at the sign-in screen, firewall, and pairing.")
            box.add(intro)
            row = Gtk.Box(spacing=8)
            row.pack_start(Gtk.Label(label="SSH login"), False, False, 0)
            addr = Gtk.Entry(placeholder_text="e.g. alex@192.168.1.20", hexpand=True)
            if p:
                addr.set_text("%s@%s" % (p["user"], p["host"]))
            row.pack_start(addr, True, True, 0)
            go = Gtk.Button(label="Open a terminal and set it up")
            go.get_style_context().add_class("suggested-action")
            row.pack_start(go, False, False, 0)
            box.add(row)
            res = Gtk.Label(xalign=0, wrap=True, max_width_chars=70, selectable=True)
            box.add(res)

            def target():
                a = addr.get_text().strip().split(":")[0]       # a pasted PairDesk address works too
                return a if a else None

            def run(*_):
                t = target()
                if not t:
                    res.set_text("Type the SSH login of the other computer first, e.g. alex@192.168.1.20")
                    return
                cmd = ["ssh", "-t", shlex.quote(t), "pairdesk", "headless-setup"]
                if self.open_terminal(cmd):
                    res.set_markup("A terminal opened: sign in there and follow the steps. When it shows a "
                                   "pairing code, use <b>+</b> on the Connect tab with the address it shows.")
                else:
                    res.set_markup("No terminal app found. Open one and run:\n<tt>%s</tt>"
                                   % GLib.markup_escape_text(" ".join(cmd)))
            go.connect("clicked", run)

            exp = Gtk.Expander(label="Or run the steps yourself")
            steps = Gtk.Grid(column_spacing=8, row_spacing=4, margin_top=6)
            first = Gtk.Label(xalign=0)
            first.set_markup("<small>Sign in first:</small>  <tt>ssh %s</tt>" % GLib.markup_escape_text(
                target() or "alex@192.168.1.20"))
            steps.attach(first, 0, 0, 2, 1)
            for i, (what, cmd) in enumerate(HEADLESS_STEPS, 1):
                cmd = cmd.replace("4722", str(C.link_port()))
                lab = Gtk.Label(xalign=0, wrap=True, max_width_chars=60)
                lab.set_markup("<b>%d.</b> %s\n<tt><small>%s</small></tt>" % (
                    i, GLib.markup_escape_text(what), GLib.markup_escape_text(cmd)))
                lab.set_selectable(True)
                steps.attach(lab, 0, i, 1, 1)
                cb = Gtk.Button.new_from_icon_name("edit-copy-symbolic", Gtk.IconSize.BUTTON)
                cb.set_tooltip_text("Copy")
                cb.set_valign(Gtk.Align.CENTER)
                cb.connect("clicked", lambda b, c=cmd: copy(c, b))
                steps.attach(cb, 1, i, 1, 1)
            exp.add(steps)
            box.add(exp)
            d.show_all()
            d.run()
            d.destroy()

        def fix_desktop(self):
            """The right fix for the desktop server: add xorgxrdp, or explain the options."""
            if C.process_running("xrdp") and not C.xorgxrdp_present():
                self.ensure("xrdp", self.refresh_status,
                            context="The desktop server here (xrdp) is missing its display part (xorgxrdp), "
                                    "so remote computers see an error instead of the desktop.")
                return
            why = C.desktop_conflict()
            if why == "signed_in":
                self.notice("Signed in on this screen",
                            "A remote desktop can't open a second desktop for a user who is signed in on this "
                            "computer's own screen. Sign out here (or let PairDesk sign this screen out when the "
                            "other computer connects).")
                return
            if why == "wayland_only":
                d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.INFO,
                                      buttons=Gtk.ButtonsType.OK, text="Use GNOME Remote Login")
                d.format_secondary_text("This GNOME runs only on Wayland, and xrdp can only start X11 desktops, so "
                                        "it fails with \"Error connecting to user session\". GNOME Remote Login "
                                        "shows your normal GNOME desktop instead, also with no monitor. PairDesk "
                                        "sets it up next.")
                d.run()
                d.destroy()
            self.desktop_help(self.cfg["mode"])

        def refresh_paired(self):
            for ch in self.paired_list.get_children():
                self.paired_list.remove(ch)
            items = C.paired_computers()
            for it in items:
                row = Gtk.Box(spacing=10, margin_top=4, margin_bottom=4)
                icon = Gtk.Image.new_from_icon_name("computer-symbolic", Gtk.IconSize.LARGE_TOOLBAR)
                row.pack_start(icon, False, False, 0)
                v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
                v.pack_start(Gtk.Label(label=it["name"], xalign=0), False, False, 0)
                if it["out"] and it["out"].get("needs_pairing"):
                    how = "Pair again (paired with an older version)"
                elif it["out"] and it["in"]:
                    how = "Paired both ways: each can connect to the other"
                elif it["out"]:
                    how = "The current computer connects to it"
                else:
                    how = "It connects to the current computer"
                sub = Gtk.Label(label=how, xalign=0)
                sub.get_style_context().add_class("db-muted")
                v.pack_start(sub, False, False, 0)
                row.pack_start(v, True, True, 0)
                b = Gtk.Button(label="Unpair", valign=Gtk.Align.CENTER)
                b.connect("clicked", lambda _b, n=it["name"], o=it: self.on_unpair(n, o))
                row.pack_end(b, False, False, 0)
                self.paired_list.add(row)
            if not items:
                e = Gtk.Label(xalign=0, wrap=True)
                e.set_markup("<small>None yet. Here: <b>Pair a new computer</b>. On the other computer: <b>+</b> on "
                             "the Connect tab.</small>")
                e.get_style_context().add_class("db-muted")
                self.paired_list.add(e)
            self.paired_list.show_all()

        def on_unpair(self, name, item):
            if self.session and self.session.name == name:
                self.error("Disconnect from %s first." % name)
                return
            d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                  text="Unpair %s?" % name)
            can_remote = bool(item["out"] and item["out"].get("link") and not item["out"].get("needs_pairing"))
            d.format_secondary_text(
                "The two computers won't be able to connect to each other any more, in either direction. "
                + ("%s is told now and removes the current computer from its list too." % name if can_remote else
                   "%s removes the current computer from its list by itself the next time PairDesk starts or "
                   "tries to connect there." % name)
                + " To use them together again, pair them with a new code.")
            both = Gtk.CheckButton(active=True)    # always remove on both sides
            d.add_button("Cancel", 0)
            d.add_button("Unpair", 1)
            pri(d, 1, danger=True, default=0)
            d.show_all()
            ok = d.run() == 1
            on_both = both.get_active()
            d.destroy()
            if not ok:
                return
            self.log("Unpairing %s…" % name)

            def done(res):
                remote_done, note = res
                self.cfg = C.load_config()
                self.refresh_peers()
                self.refresh_paired()
                if note:
                    self.notice("Unpaired %s" % name, note)
                else:
                    self.log("Unpaired %s%s." % (name, " on both computers" if remote_done else ""))
            bg(lambda: C.unpair(name, both=on_both, log=lambda m: None), done)

        def refresh_status(self):
            self.refresh_paired()

            def done(st):
                m = self.cfg["mode"]
                on = m in ("server", "both")
                lp = C.link_port()
                self.pair_btn.set_sensitive(on and C.feature_present("accept"))
                self.pair_btn.set_tooltip_text(None if on and C.feature_present("accept") else
                                               "Turn on remote access above first" if not on else
                                               "Needs the SSH server program: press Install under Status")
                self.link_lbl.set_markup(("<small>Address</small>  <b>%s</b>" % GLib.markup_escape_text(
                    "   ".join(my_addresses()) or "?")) if on else
                    "<small>Turn on to pair or accept computers.</small>")
                if not C.feature_present("accept"):
                    self.st_labels["ssh"].set_text("SSH server program missing" if on else "Off")
                elif C.link_running():
                    self.st_labels["ssh"].set_text("✔ Listening on port %d" % lp)
                else:
                    self.st_labels["ssh"].set_text("Off" if not on else "✘ Not running (port %d)" % lp)
                warn = C.desktop_warning() if on else None
                if on and warn:
                    why = {"xorgxrdp": " (xorgxrdp missing)", "wayland_only": " (xrdp can't start this GNOME)",
                           "signed_in": " (you're signed in on this screen)"}.get(C.desktop_conflict(), "")
                    self.st_labels["rdp"].set_text("✘ Can't show a desktop" + why)
                    self.st_labels["rdp"].set_tooltip_text(warn)
                elif not on:
                    self.st_labels["rdp"].set_text("Off")
                elif st.get("rdp_listening"):
                    self.st_labels["rdp"].set_text("✔ On (%s)" % {"gnome": "GNOME Remote Login", "xrdp": "xrdp"}.get(
                        st.get("rdp_backend"), "running"))
                else:
                    self.st_labels["rdp"].set_text("Off (folders and USB still work)")
                if st.get("nosetup"):
                    self.st_labels["usb"].set_text("Off (optional)")
                else:
                    self.st_labels["usb"].set_text("✔ Ready" if st.get("usbipd_active") else "✘ Service not running")
                self.fix_btns["ssh"].set_visible(on and not C.feature_present("accept"))
                self.fix_btns["rdp"].set_visible(on and (not st.get("rdp_listening") or bool(warn)))
                self.fix_btns["usb"].set_visible(bool(st.get("nosetup")))
                # Settings page details
                added = C.added_by_pairdesk()
                have = ["%s%s" % (C.FEATURES[k]["title"], " *" if C.feature_packages(k) & added else "")
                        for k in C.FEATURES if C.feature_present(k)]
                self.addons_lbl.set_text("\n".join(have) + ("\n* added by PairDesk" if any(
                    h.endswith("*") for h in have) else "") if have else "None yet (added when first needed)")
                self.port_lbl.set_text("Port %d" % lp)
                self._quiet = True
                self.lock_rdp.set_active(st.get("lock_rdp", True) and not st.get("nosetup"))
                self.lock_rdp.set_sensitive(not st.get("nosetup"))
                self.lock_rdp.set_tooltip_text("Needs the optional USB setup (Settings > Set up USB sharing)"
                                               if st.get("nosetup") else None)
                if st.get("rdp_backend"):
                    self.backend.set_active_id(st["rdp_backend"])
                self._quiet = False

            def fallback(_e):      # no setup: report what can be seen without admin rights
                done({"nosetup": True, "rdp_listening": C.port_listening(3389), "lock_rdp": True})
            bg(lambda: C.helper("status", interactive=False), done, fallback)

        def on_lock(self, cb):
            if self._quiet:
                return
            bg(lambda: C.helper("set-lock-rdp", "on" if cb.get_active() else "off", interactive=True),
               lambda _r: self.refresh_status())

        # --------------------------------------------------------- Settings page
