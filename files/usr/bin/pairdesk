                                             self.save()))
            page.pack_start(self.frame("Desktop window", dw), False, False, 0)

            gc = Gtk.Grid(column_spacing=12, row_spacing=8)
            self.port_lbl = Gtk.Label(label="Port %d" % C.link_port(), xalign=0)
