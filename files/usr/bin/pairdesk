#!/usr/bin/python3
"""PairDesk - remote desktop with USB, webcam, security keys, folders,
clipboard and sound, both ways, over PairDesk's own encrypted link.

  pairdesk                    open the app
  pairdesk access on|off      let paired computers connect (opens/closes PairDesk's port)
  pairdesk pair-code          show a one-time code so another computer can pair (needs access on)
  pairdesk headless-setup     guided setup of a computer without a monitor (run it there over SSH)
  pairdesk desktop gnome|xrdp choose the desktop server (GNOME Remote Login for GNOME on Wayland)
  pairdesk pairing            for a computer without a screen (run over SSH): shows the code a
                                pairing request is waiting for, and waits until it's used
  pairdesk pair ADDRESS [CODE]  pair with a remote computer, e.g. 192.168.1.20; without CODE
                                it asks the remote computer to show one, then asks you to type it
  pairdesk pair ADDRESS --ssh [LOGIN]  pair by signing in to it over SSH: no code to type
  pairdesk port N             PairDesk's port (default 4722)
  pairdesk scan               find computers with remote access on
  pairdesk setup              optional: USB sharing + network protection (asks admin password)
  pairdesk unsetup            undo that setup (USB devices are given back first)
  pairdesk list               paired computers
  pairdesk usb                USB devices on the current computer
  pairdesk send NAME KEY|off  choose a USB device to send to NAME on connect
  pairdesk take NAME KEY|off  choose a USB device of NAME to use on the current computer
  pairdesk connect NAME [--no-desktop]
  pairdesk --connect NAME     open the app and connect (used by shortcuts)
  pairdesk unpair NAME         remove a pairing on both computers
  pairdesk update NAME        update whichever computer has the older PairDesk (asks first)
  pairdesk update --install   install the update a paired computer sent here
  pairdesk features | install NAME | uninstall
"""

import getpass
import json
import os
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import textwrap
import threading
import time

sys.path.insert(0, "/usr/lib/pairdesk")
import dbcore as C  # noqa: E402


# ======================================================================= shared
def set_mode(mode, backend="auto", rdp_user=None, rdp_password=None, interactive=False):
    """Switch Client/Server/Both. Switching never asks for anything: system changes
    are made only when they need no password (after setup), or when interactive=True
    because the person pressed a setup button."""
    if mode not in ("client", "server", "both"):
        raise C.DBError("mode must be client, server or both")
    rep = {}
    # Remote access only opens or closes PairDesk's own port. The desktop server is set up separately
    # (Desktop sharing > Set up, or pairdesk desktop gnome|xrdp) and is never switched off here: turning
    # it back on can need a password (GNOME Remote Login) that switching access can't ask for.
    if mode in ("server", "both") and backend not in (None, "none"):
        if interactive or (C.setup_done() and C.rdp_server() is None and backend == "xrdp"):
            payload = json.dumps({"user": rdp_user or getpass.getuser(), "password": rdp_password or ""})
            try:
                rep = C.helper("server-enable", backend, getpass.getuser(), stdin=payload,
                               interactive=interactive)
            except C.SetupNeeded:
                rep = {}      # no admin rights: still accept connections
    c = C.load_config()
    c["mode"] = mode
    C.save_config(c)
    C.ensure_key()
    C.share_dir(c)
    # PairDesk's own port: open only while remote access is on (runs as you, no admin rights)
    if mode in ("server", "both"):
        try:
            C.link_start()
            rep["link_port"] = C.link_port()
        except C.DBError as e:
            rep["link_error"] = str(e)
    else:
        C.stop_pairing()
        C.link_stop()
    return rep


def local_ips():
    """IPv4 addresses other computers can use: skips Docker, VM and container bridges."""
    skip = ("docker", "br-", "veth", "virbr", "lxc", "lxd", "vmnet", "vboxnet", "podman", "cni", "flannel")
    ips = []
    try:
        data = json.loads(subprocess.run(["ip", "-j", "-4", "addr"], capture_output=True, text=True).stdout or "[]")
        for it in data:
            name = it.get("ifname", "")
            if name == "lo" or name.startswith(skip):
                continue
            ips += [a["local"] for a in it.get("addr_info", []) if a.get("local")]
    except (OSError, ValueError):
        pass
    if not ips:
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            s.connect(("192.0.2.1", 9))
            ips.append(s.getsockname()[0])
            s.close()
        except OSError:
            pass
    return ips

def my_addresses():
    """How other computers reach this one: just the IP, plus the port only when it isn't the default.
    (The user name is filled in by itself when they add this computer.)"""
    lp = C.link_port()
    return [ip if lp == C.LINK_PORT else "%s:%d" % (ip, lp) for ip in local_ips()]


def needs_setup():
    return not C.setup_done(max_age=0), {}


