            xb = Gtk.Button(label="Uninstall PairDesk…")
            xb.get_style_context().add_class("destructive-action")
            xb.connect("clicked", lambda *_: self.uninstall())
            g2.attach(xb, 0, 3, 1, 1)
            g2.attach(Gtk.Label(label="Removes PairDesk and only the add-ons it installed. Shared folder "
                                      "files are kept.", xalign=0, wrap=True, max_width_chars=60), 1, 3, 1, 1)
            lb = Gtk.Button(label="Open log file")
            lb.connect("clicked", lambda *_: self.open_path(C.log_file()))
            g2.attach(lb, 0, 1, 1, 1)
            g2.attach(Gtk.Label(label="Send this to whoever helps you if something doesn't work.",
                                xalign=0, wrap=True), 1, 1, 1, 1)
            page.pack_start(self.frame("Maintenance", g2), False, False, 0)
            about = Gtk.Label(xalign=0, margin=12)
            about.set_markup("<small>PairDesk %s · open source (MIT) · RDP + USB/IP + SFTP inside SSH</small>" % C.VERSION)
            page.pack_end(about, False, False, 0)
            return page

        def set_look(self, key, value):
            self.cfg[key] = value
            self.save()
            apply_theme(self.cfg)

        def on_share_dir(self, fc):
            self.cfg["share_dir"] = fc.get_filename()
            self.save()

        def on_readonly(self, cb):
            self.cfg["share_readonly"] = cb.get_active()
            self.save()

        # --------------------------------------------------------- setup & mode
        def show_setup_state(self, res):
            need, _st = res
            self.usb_ok = not need
            self.refresh_local(force=True)
            if need and not self.cfg.get("setup_dismissed"):
                self.info_lbl.set_text("Optional: set up USB sharing (security keys, webcams, drives) and network "
                                       "protection. Needs your admin password once. Desktop, sound, clipboard "
                                       "and folders already work without it.")
                self.info.set_no_show_all(False)
                self.info.show_all()
            else:
                self.info.hide()

        def offer_pending(self):
            up = C.pending_update()
            if up:
                offer_update(up["path"], up.get("peer") or "A paired computer", parent=self)
                self.cfg = C.load_config()
            pend = dict(self.cfg.get("pending_features") or {})
            items = []
            for name, info in pend.items():
                if name in C.FEATURES and not C.feature_present(name):
                    items.append((name, info.get("why"), None))
            self.cfg["pending_features"] = {}
            self.save()
            if items:
                self.ensure_all(items, lambda: None)
            return False

        def on_info_response(self, _bar, resp):
            if resp == 1:
                self.do_setup()
            else:
                self.cfg["setup_dismissed"] = True
                self.save()
                self.info.hide()
                self.log("Setup skipped. You can do it later in Settings.")

        def do_setup(self):
            if not C.feature_present("usb"):
                d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                      text="Set up USB sharing?")
                d.format_secondary_text(
                    "Setup adds " + C.FEATURES["usb"]["title"] + ". " + C.feature_text("usb") +
                    "\n\nIt also turns on PairDesk's USB service and a network rule that keeps USB sharing "
                    "off your network except through PairDesk. You'll be asked for your admin password.")
                d.add_button("Not now", 0)
                d.add_button("Set up", 1)
                pri(d, 1)
                ok = d.run() == 1
                d.destroy()
                if not ok:
                    return
            def do(on_line):
                C.helper_stream("setup", getpass.getuser(), on_line=on_line)
                C._setup_cache[0] = 0
                C.ensure_key()
                C.share_dir()

            def after(_r):
                self.info.hide()
                self.refresh_status()
                self.show_setup_state((False, {}))
            self.with_progress("Setting up USB sharing", "Waiting for your admin password…", do,
                               "USB sharing and network protection are on.", after=after)

        def uninstall(self):
            if self.session:
                self.error("Disconnect first.")
                return
            d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                                  text="Uninstall PairDesk from the current computer?")
            d.format_secondary_text(
                "Shared USB devices are given back, setup is undone, and PairDesk is removed together with "
                "the add-ons it installed. Packages you installed yourself, or that other software uses, are "
                "kept. Files in your shared folder are kept.")
            box = d.get_message_area()
            ssh = Gtk.CheckButton(label="Also remove the SSH server if PairDesk installed it "
                                        "(leave this off if you use SSH)")
            st = Gtk.CheckButton(label="Also delete PairDesk settings (pairings, keys, shortcuts)")
            box.pack_start(ssh, False, False, 0)
            box.pack_start(st, False, False, 0)
            d.add_button("Cancel", 0)
            d.add_button("Uninstall", 1)
            pri(d, 1, danger=True, default=0)
            d.show_all()
            ok = d.run() == 1
            args = ["--yes"] + ([] if ssh.get_active() else ["--keep-ssh-server"]) + \
                (["--remove-settings"] if st.get_active() else ["--keep-settings"])
            d.destroy()
            if not ok:
                return
            def do(on_line):
                p = subprocess.Popen(["pkexec", "/usr/sbin/pairdesk-uninstall"] + args, stdout=subprocess.PIPE,
                                     stderr=subprocess.STDOUT, text=True, bufsize=1)
                out = []
                for line in p.stdout:
                    out.append(line.rstrip())
                    on_line(line.rstrip())
                rc = p.wait()
                if rc in (126, 127) and len(out) <= 1:
                    raise C.DBError("Admin password was not given.")
                if rc != 0:
                    raise C.DBError(next((l for l in reversed(out) if l.strip()), "failed"))
                return out

            def summary(out):
                keep = [l.strip() for l in out if l.strip().startswith(("removed:", "kept"))]
                return "PairDesk was removed.\n" + "\n".join(keep)

            pw = self.with_progress("Uninstalling PairDesk", "Waiting for your admin password…", do, summary,
                                    after=lambda _o: pw.connect("destroy", lambda *_: Gtk.main_quit()))

        def undo_setup(self):
            if self.session:
                self.error("Disconnect first, so USB devices can be given back cleanly.")
                return
            d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                  buttons=Gtk.ButtonsType.OK_CANCEL, text="Undo setup on the current computer?")
            d.format_secondary_text("USB devices are given back, the USB service and network protection are "
                                    "turned off, and PairDesk's admin permission is removed. If PairDesk set "
                                    "up a desktop server for Server mode, that is turned off too. Pairings, "
                                    "folders and the desktop keep working.")
            ok = d.run() == Gtk.ResponseType.OK
            d.destroy()
            if not ok:
                return
            def do(on_line):
                on_line("step:Giving USB devices back and turning the USB service off")
                r = C.helper_stream("unsetup", getpass.getuser(), on_line=on_line)
                C._setup_cache[0] = 0
                return r

            def done(r):
                self.cfg = C.load_config()
                self.cfg["setup_dismissed"] = True
                self.save()
                self.usb_ok = False
                self.refresh_local(force=True)
                self.refresh_status()
            self.with_progress("Undoing setup", "Waiting for your admin password…", do,
                               "USB sharing is off; desktop and folders still work.", after=done)

        def accepting(self):
            return self.cfg.get("mode") in ("server", "both")

        def apply_mode_visibility(self):
            on = self.accepting()
            self.pill.set_label("● Accepting connections" if on else "○ Not accepting connections")
            ctx = self.pill.get_style_context()
            ctx.remove_class("db-pill-on" if not on else "db-pill-off")
            ctx.add_class("db-pill-on" if on else "db-pill-off")
            if hasattr(self, "accept_sw") and self.accept_sw.get_active() != on:
                self._quiet = True
                self.accept_sw.set_active(on)
                self._quiet = False

        def on_accept(self, sw, _param):
            if not self._quiet:
                self.on_mode(None, "both" if sw.get_active() else "client")

        def on_mode(self, btn, mode, force=False):
            """Switching never shows dialogs or asks for a password. Missing pieces appear as
            buttons on the Current computer tab."""
            if btn is not None and not btn.get_active():
                return
            if self._quiet:
                return
            if force and mode in ("server", "both"):
                self.desktop_help(mode)          # "Set up desktop sharing…" button
                return
            prev = self.cfg["mode"]
            backend = "auto" if C.setup_done() else "none"

            def revert(msg):
                self.cfg["mode"] = prev
                self.apply_mode_visibility()
                self.error(msg)

            def done(rep):
                self.cfg = C.load_config()
                self.apply_mode_visibility()
                self.refresh_status()
                if mode == "client":
                    self.log("Remote access is off: PairDesk's port is closed.")
                    return
                if rep.get("link_error") and C.feature_present("accept"):
                    self.error(rep["link_error"])
                todo = []
                if mode in ("server", "both"):
                    if not C.feature_present("accept"):
                        todo.append("install the SSH server")
                    if not C.port_listening(3389):
                        todo.append("set up desktop sharing")
                self.log("Remote access is on%s." % (
                    ". To finish: %s (buttons on the Current computer tab)" % " and ".join(todo) if todo else ""))
            bg(lambda: set_mode(mode, backend), done, revert)

        def desktop_help(self, mode=None):
            """Explain the desktop server and offer: set it up for me / show me how / later."""
            mode = mode or self.cfg["mode"]
            here = C.desktop_server_here()
            kind = "gnome" if here["gnome"] else "xrdp"
            text, steps = C.DESKTOP_HELP[kind]
            d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                  text="Share the desktop of the current computer?")
            d.format_secondary_text(
                "Remote computers can already connect for folders and USB devices. To also show the "
                "desktop of the current computer, a desktop server has to be on.\n\n" + text +
                ("\n\n\"Set it up for me\" asks for your admin password once." if kind == "gnome" else
                 "\n\n\"Install it for me\" downloads xrdp (a few minutes) and asks for your admin password."))
            d.add_button("Later", 3)
            d.add_button("Show me how", 2)
            d.add_button("Set it up for me" if kind == "gnome" else "Install it for me", 1)
            pri(d, 1)
            r = d.run()
            d.destroy()
            if r == 1 and kind == "xrdp" and not C.feature_present("xrdp"):
                pass    # installed below together with its setup
            if r == 1 and kind == "gnome":
                got = self.ask_server_password()
                if not got:
                    return
                self.log("Turning on GNOME Remote Login…")
                bg(lambda: set_mode(mode, "gnome", got[0], got[1], interactive=True), self._desktop_done)
            elif r == 1:
                self.log("Installing xrdp (this can take a few minutes)…")
                self.status.set_text("Installing xrdp…")
                self.with_progress("Installing the desktop server (xrdp)", "Waiting for your admin password…",
                                   lambda on_line: C.helper_stream("install-xrdp", getpass.getuser(), on_line=on_line),
                                   "xrdp is installed and running.", after=self._desktop_done)
            elif r == 2:
                self.show_steps(kind, steps)
            else:
                self.cfg["desktop_later"] = True
                self.save()
                self.log("Desktop sharing skipped for now. Set it up any time on the Current computer tab.")

        def _desktop_done(self, rep):
            self.cfg = C.load_config()
            self.cfg.pop("desktop_later", None)
            self.save()
            self.refresh_status()
            if C.port_listening(3389) or (rep or {}).get("backend"):
                self.notice("Desktop sharing is on",
                            "Remote computers can now see the desktop of the current computer." +
                            (" They log in with the Remote Login user name and password you just chose."
                             if (rep or {}).get("backend") == "gnome" else
                             " They log in with this computer's normal user name and password."))
            else:
                self.error("The desktop server didn't start. Try \"Show me how\" on the Current computer tab.")

        def show_steps(self, kind, steps):
            d = Gtk.Dialog(title="Turn on desktop sharing", transient_for=self, modal=True)
            box = d.get_content_area()
            box.set_spacing(6)
            for m in ("set_margin_start", "set_margin_end", "set_margin_top"):
                getattr(box, m)(14)
            for n, st in enumerate(steps, 1):
                lbl = Gtk.Label(xalign=0, wrap=True, max_width_chars=60, selectable=True)
                lbl.set_markup("<b>%d.</b>  %s" % (n, GLib.markup_escape_text(st)))
                box.add(lbl)
            if kind == "gnome":
                d.add_button("Open Settings", 1)
            d.add_button("Done", 0)
            pri(d, 0)
            d.show_all()
            while d.run() == 1:
                for cmd in (["gnome-control-center", "system"], ["gnome-control-center", "remote-desktop"],
                            ["gnome-control-center"]):
                    try:
                        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        break
                    except OSError:
                        continue
            d.destroy()
            self.refresh_status()

        def ask_server_password(self):
            d = Gtk.Dialog(title="Remote desktop login", transient_for=self, modal=True)
            d.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Save", Gtk.ResponseType.OK)
            pri(d, Gtk.ResponseType.OK)
            g = Gtk.Grid(column_spacing=8, row_spacing=8, margin=12)
            msg = Gtk.Label(xalign=0, wrap=True, max_width_chars=48)
            msg.set_text("GNOME Remote Login uses its own user name and password. "
                         "Remote computers type these to see the desktop of the current computer. They can "
                         "differ from your normal login. You'll be asked for your admin password next to save them.")
            u = Gtk.Entry(text=getpass.getuser())
            pw = Gtk.Entry(visibility=False, activates_default=True)
            g.attach(msg, 0, 0, 2, 1)
            g.attach(Gtk.Label(label="User", xalign=1), 0, 1, 1, 1)
            g.attach(u, 1, 1, 1, 1)
            g.attach(Gtk.Label(label="Password", xalign=1), 0, 2, 1, 1)
            g.attach(pw, 1, 2, 1, 1)
            d.get_content_area().add(g)
            d.show_all()
            pw.grab_focus()
            r = d.run()
            res = (u.get_text().strip(), pw.get_text())
            d.destroy()
            return res if r == Gtk.ResponseType.OK and res[1] else None

    app = App(auto_connect)
    Gtk.main()
    try:
        os.unlink(os.path.join(C.run_dir(), "gui.pid"))
    except OSError:
        pass


def pairing_popup():
    """Shown on the current computer when a remote computer asks to pair and PairDesk isn't open."""
    import time
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, GLib
    pr = C.load_config().get("pairing") or {}
    if not pr or pr.get("expires", 0) < time.time():
        return
    before = dict(C.load_config()["incoming"])
    d = Gtk.Dialog(title="PairDesk pairing request")
    d.set_keep_above(True)
    d.set_icon_name("pairdesk")
    d.add_button("Cancel", 0)
    box = d.get_content_area()
    box.set_spacing(10)
    for m in ("set_margin_start", "set_margin_end", "set_margin_top", "set_margin_bottom"):
        getattr(box, m)(16)
    rq = Gtk.Label(xalign=0, wrap=True, max_width_chars=50)
    rq.set_markup("<b>%s</b> wants to pair with the current computer. If that's you, type this code there. "
                  "If not, press Cancel." % GLib.markup_escape_text(pr.get("requested_by", "A computer")))
    box.add(rq)
    box.add(code_view(C.fmt_code(pr["code"])))
    left = Gtk.Label(xalign=0)
    box.add(left)
    d.show_all()
    state = {"paired": False}

    def tick():
        c = C.load_config()
        if any(before.get(n) != v for n, v in c["incoming"].items()):
            state["paired"] = True
            d.response(1)
            return False
        p = c.get("pairing")
        if not p or p["expires"] < time.time():
            d.response(0)
            return False
        secs = int(p["expires"] - time.time())
        left.set_text("Code works for %d:%02d more" % (secs // 60, secs % 60))
        return True
    tick()
    GLib.timeout_add(1000, tick)
    d.run()
    if not state["paired"]:
        C.stop_pairing()


def logout_countdown(secs, peer, ids):
    """On the remote computer's own screen: someone wants to use this desktop remotely."""
    import time
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, GLib
    state = C.logout_state_path(peer)
    d = Gtk.Dialog(title="PairDesk")
    d.set_keep_above(True)
    d.set_urgency_hint(True)
    d.set_icon_name("pairdesk")
    d.add_button("Cancel", 0)
    b = d.add_button("Sign out now", 1)
    b.get_style_context().add_class("destructive-action")
    box = d.get_content_area()
    box.set_spacing(10)
    for m in ("set_margin_start", "set_margin_end", "set_margin_top", "set_margin_bottom"):
        getattr(box, m)(18)
    t = Gtk.Label(xalign=0, wrap=True, max_width_chars=50)
    t.set_markup("<b>%s wants to use this desktop remotely.</b>" % GLib.markup_escape_text(peer))
    box.add(t)
    msg = Gtk.Label(xalign=0, wrap=True, max_width_chars=50)
    box.add(msg)
    bar = Gtk.ProgressBar()
    box.add(bar)
    d.show_all()
    end = time.time() + secs

    def tick():
        left = end - time.time()
        if left <= 0:
            d.response(1)
            return False
        msg.set_text("This session will be signed out in %d seconds. Save your work, or press Cancel to stay "
                      "signed in." % int(left + 0.99))
        bar.set_fraction(1 - left / secs)
        return True
    tick()
    GLib.timeout_add(200, tick)
    r = d.run()
    d.destroy()
    # PairDesk's link does the sign-out (this window ends with the session): just tell it what was chosen
    with open(state, "w") as f:
        f.write("now" if r == 1 else "cancelled")


def code_view(code):
    """A pairing code, hidden until Show is pressed (screens can be seen by others, e.g. when sharing)."""
    from gi.repository import Gtk
    box = Gtk.Box(spacing=10)
    lbl = Gtk.Label(xalign=0, selectable=False)
    btn = Gtk.Button(label="Show", valign=Gtk.Align.CENTER)
    btn.set_tooltip_text("Show or hide the pairing code")
    hidden = [True]

    def paint(*_):
        txt = "••••-••••-••••-••••" if hidden[0] else code
        lbl.set_selectable(not hidden[0])
        lbl.set_markup("<span size='x-large' weight='bold' font_family='monospace'>%s</span>" % txt)
        btn.set_label("Show" if hidden[0] else "Hide")

    def toggle(*_):
        hidden[0] = not hidden[0]
        paint()
    btn.connect("clicked", toggle)
    paint()
    box.pack_start(lbl, False, False, 0)
    box.pack_start(btn, False, False, 0)
    return box


def offer_update(path, peer, parent=None):
    """On this computer's screen: a paired computer sent a newer PairDesk. An administrator decides."""
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, GLib
    esc = GLib.markup_escape_text
    ver = C.deb_fields(path).get("Version") if os.path.isfile(path) else None
    have = C.installed_version() or C.VERSION
    if not ver or not C.version_newer(ver, have):
        return False
    d = Gtk.Dialog(title="PairDesk update", transient_for=parent, modal=parent is not None)
    d.set_keep_above(parent is None)
    d.set_icon_name("pairdesk")
    later = d.add_button("Not now", 0)
    go = d.add_button("Install update", 1)
    go.get_style_context().add_class("suggested-action")
    d.set_default_response(1)
    box = d.get_content_area()
    box.set_spacing(10)
    for m in ("set_margin_start", "set_margin_end", "set_margin_top", "set_margin_bottom"):
        getattr(box, m)(18)
    t = Gtk.Label(xalign=0, wrap=True, max_width_chars=52)
    t.set_markup("<b>%s sent a newer PairDesk</b>" % esc(peer))
    box.add(t)
    msg = Gtk.Label(xalign=0, wrap=True, max_width_chars=52, selectable=True)
    msg.set_text("PairDesk %s is ready to install. This computer has %s.\n\nInstalling needs an "
                 "administrator's password on this computer. Paired computers keep working while it "
                 "installs." % (ver, have))
    box.add(msg)
    bar = Gtk.ProgressBar(no_show_all=True)
    box.add(bar)
    d.show_all()
    state = {"busy": False}

    def already():          # installed meanwhile (e.g. over SSH): say so and stop offering it
        if state["busy"] or not go.get_visible():
            return True
        now = C.installed_version()
        if os.path.isfile(path) and not (now and not C.version_newer(ver, now)):
            return True
        msg.set_text("PairDesk %s is installed now (it was installed another way, e.g. over SSH). Nothing "
                     "more to do." % (now or ver))
        go.hide()
        later.set_label("Close")
        c = C.load_config()
        if c.pop("pending_update", None) is not None:
            C.save_config(c)
        return False
    GLib.timeout_add(2000, already)

    def run_install():
        def line(l):
            if l.startswith("pmstatus:"):
                parts = l.split(":", 3)
                try:
                    GLib.idle_add(bar.set_fraction, float(parts[2]) / 100)
                except (IndexError, ValueError):
                    pass

        def finish(text, ok):
            state["busy"] = False
            bar.hide()
            msg.set_text(text)
            go.hide()
            later.set_label("Close")
            later.set_sensitive(True)
            if ok:
                later.grab_focus()
            return False
        try:
            C.install_update(path, on_line=line)
            GLib.idle_add(finish, "PairDesk %s is installed. Open PairDesk again to use the new version." % ver, True)
        except C.DBError as e:
            GLib.idle_add(finish, "The update wasn't installed: %s\n\nIt stays ready: PairDesk offers it "
                          "again when you open it." % e, False)

    def on_resp(_d, r):
        if state["busy"]:
            d.stop_emission_by_name("response")
            return
        if r == 1 and go.get_visible():
            if not already():
                d.stop_emission_by_name("response")
                return
            state["busy"] = True
            go.set_sensitive(False)
            later.set_sensitive(False)
            msg.set_text("Installing PairDesk %s… Type the administrator's password when asked." % ver)
            bar.show()
            bar.set_fraction(0)
            threading.Thread(target=run_install, daemon=True).start()
            d.stop_emission_by_name("response")
    d.connect("response", on_resp)
    d.connect("delete-event", lambda *_: state["busy"])
    d.run()
    d.destroy()
    return True


def askpass(prompt):
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk
    d = Gtk.Dialog(title="PairDesk", modal=True)
    d.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "OK", Gtk.ResponseType.OK)
    d.set_default_response(Gtk.ResponseType.OK)
    ok_b = d.get_widget_for_response(Gtk.ResponseType.OK)
    if ok_b is not None:
        ok_b.get_style_context().add_class("suggested-action")
    box = d.get_content_area()
    box.set_spacing(8)
    box.set_margin_start(12)
    box.set_margin_end(12)
    box.set_margin_top(12)
    lbl = Gtk.Label(label=prompt.strip() + "\n\nAsked once for this session. PairDesk doesn't save it.",
                    xalign=0, wrap=True, max_width_chars=60)
    box.add(lbl)
    yesno = "(yes/no" in prompt
    e = Gtk.Entry(visibility=yesno, activates_default=True, text="yes" if yesno else "")
    box.add(e)
    d.show_all()
    r = d.run()
    if r == Gtk.ResponseType.OK:
        print(e.get_text())
        sys.exit(0)
    sys.exit(1)


def main():
    try:
        sys.stdout.reconfigure(line_buffering=True)    # live output over SSH and in pipes
    except AttributeError:
        pass
    argv = sys.argv[1:]
    if argv and argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    if argv and argv[0] == "--askpass" or (len(argv) == 1 and os.environ.get("SSH_ASKPASS_REQUIRE")
                                           and not argv[0].startswith("-") and " " in argv[0]):
        askpass(argv[-1])
        return
    if argv and argv[0] == "--logout-countdown" and len(argv) >= 4:
        logout_countdown(int(argv[1]), argv[2], argv[3:])
        return
    if argv and argv[0] == "--offer-update" and len(argv) == 3:
        offer_update(argv[1], argv[2])
        return
    if argv and argv[0] == "--pairing-popup":
        pairing_popup()
        return
    if not argv or argv[0] == "--connect":
        # The remote desktop is shown inside PairDesk's window through X11 (XWayland on a Wayland desktop)
        if os.environ.get("WAYLAND_DISPLAY") and os.environ.get("DISPLAY") and not os.environ.get("GDK_BACKEND") \
                and C.load_config().get("desktop_in_window", True):
            os.environ["GDK_BACKEND"] = "x11"
    if argv and argv[0] == "--connect" and len(argv) == 2:
        gui(argv[1])
        return
    if argv:
        try:
            cli(argv)
        except C.DBError as e:
            sys.exit("pairdesk: " + str(e))
        except (IndexError, KeyError, ValueError):
            sys.exit(__doc__)
        return
    gui()


if __name__ == "__main__":
    main()
