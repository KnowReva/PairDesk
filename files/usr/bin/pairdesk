            gc.attach(pb, 2, 0, 1, 1)
            gc.attach(Gtk.Label(label="Desktop server", xalign=1), 0, 1, 1, 1)
            self.backend = Gtk.ComboBoxText()
            for k, lbl in (("auto", "Automatic"), ("gnome", "GNOME Remote Login"), ("xrdp", "xrdp (any desktop)")):
                self.backend.append(k, lbl)
            self.backend.set_active_id("auto")
            gc.attach(self.backend, 1, 1, 1, 1)
            ap = Gtk.Button(label="Set up…")
            ap.set_tooltip_text("Explains the options and turns the desktop server on")
            ap.connect("clicked", lambda *_: self.on_mode(None, self.cfg["mode"], force=True)
                       if self.cfg["mode"] != "client" else
                       self.notice("Turn on remote access first",
                                   "Desktop sharing lets remote computers see the current computer. Turn on "
                                   "remote access on the Current computer tab."))
            gc.attach(ap, 2, 1, 1, 1)
            self.lock_rdp = Gtk.CheckButton(label="Only allow the desktop through PairDesk (encrypted)")
            self.lock_rdp.connect("toggled", self.on_lock)
            gc.attach(self.lock_rdp, 1, 2, 2, 1)
            po = Gtk.CheckButton(label="Accept pairing requests only after I press \"Pair a new computer\"",
                                 active=self.cfg.get("pair_only_on_press", False))
            po.set_tooltip_text("Off: another computer can ask this one to show a pairing code. On: it's refused "
                                "unless a code is already showing here.")
            po.connect("toggled", lambda b: (self.cfg.__setitem__("pair_only_on_press", b.get_active()),
                                             self.save()))
            gc.attach(po, 1, 3, 2, 1)
            page.pack_start(self.frame("Connection", gc), False, False, 0)

            ga = Gtk.Grid(column_spacing=12, row_spacing=8)
            ga.attach(Gtk.Label(label="Theme", xalign=1), 0, 0, 1, 1)
            th = Gtk.ComboBoxText()
            for k, lbl in (("system", "Same as system"), ("light", "Light"), ("dark", "Dark")):
                th.append(k, lbl)
            th.set_active_id(self.cfg.get("theme", "system"))
            th.connect("changed", lambda c: self.set_look("theme", c.get_active_id()))
            ga.attach(th, 1, 0, 1, 1)
            ga.attach(Gtk.Label(label="Accent colour", xalign=1), 0, 1, 1, 1)
            ac = Gtk.ComboBoxText()
            for k in ACCENTS:
                ac.append(k, k.capitalize())
            ac.set_active_id(self.cfg.get("accent", "azure"))
            ac.connect("changed", lambda c: self.set_look("accent", c.get_active_id()))
            ga.attach(ac, 1, 1, 1, 1)
            ga.attach(Gtk.Label(label="Style", xalign=1), 0, 2, 1, 1)
            sty = Gtk.ComboBoxText()
            sty.append("brand", "PairDesk (graphite)")
            sty.append("system", "System theme")
            sty.set_active_id(self.cfg.get("style", "brand"))
            sty.connect("changed", lambda c: self.set_look("style", c.get_active_id()))
            ga.attach(sty, 1, 2, 1, 1)
            page.pack_start(self.frame("Appearance", ga), False, False, 0)

            self.addons_lbl = Gtk.Label(xalign=0, wrap=True, selectable=True)
            page.pack_start(self.frame("Add-ons on the current computer", self.addons_lbl), False, False, 0)

            g2 = Gtk.Grid(column_spacing=12, row_spacing=8)
            b = Gtk.Button(label="Set up USB sharing")
            b.connect("clicked", lambda *_: self.do_setup())
            g2.attach(b, 0, 0, 1, 1)
            g2.attach(Gtk.Label(label="Optional, needs your admin password once. Adds USB sharing (security keys, "
